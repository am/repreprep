---
import "../styles/app.css";
import { ClientRouter } from "astro:transitions";
import { INSTRUMENTS } from "../course/index.js";
import Logo from "../components/Logo.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { SIGN_IN } from "../lib/features.js";

interface Props { title?: string; description?: string; inst?: any; tab?: string; home?: boolean }
const { title, description = "Hands-on lessons that teach music production on your own instruments, one short practice at a time.", inst, tab, home } = Astro.props;
const full = title ? `${title} · Rep Rep Rep` : "Rep Rep Rep";
const tabs = inst?.ready ? [["lessons", "Lessons", ""], ["panel", "Panel guide", "/panel"], ["machines", "Machines", "/machines"], ["shortcuts", "Shortcuts", "/shortcuts"]] : [];
// steps per lesson, so the browser can count progress without loading the whole course
const sizes = inst?.ready ? JSON.stringify(Object.fromEntries(inst.lessons.map((l: any) => [l.id, l.steps.length]))) : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{full}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Rasa:ital,wght@0,300..700;1,300..700&family=IBM+Plex+Mono:wght@500;600;700&display=swap">
  <script is:inline>
    /* apply the saved layout before the first paint: full-window player, step panel width */
    window.__rrrLayout = function () {
      try {
        var s = JSON.parse(localStorage.getItem("repreprep-progress-v1") || "null") || {};
        var r = document.documentElement;
        r.classList.toggle("focus", !!s.focus && !!document.getElementById("player"));
        if (s.stepW) r.style.setProperty("--sw", s.stepW + "px"); else r.style.removeProperty("--sw");
      } catch (e) {}
    };
    document.addEventListener("astro:after-swap", window.__rrrLayout);
    /* theme: auto follows the system, light and dark are saved choices; applied before the first paint */
    (function () {
      function get() { try { return localStorage.getItem("rrr-theme") || "auto"; } catch (e) { return "auto"; } }
      function apply() {
        var t = get(), r = document.documentElement;
        if (t === "light" || t === "dark") r.setAttribute("data-theme", t); else r.removeAttribute("data-theme");
        Array.prototype.forEach.call(document.querySelectorAll("[data-theme-set]"), function (b) { b.setAttribute("aria-checked", String(b.getAttribute("data-theme-set") === t)); });
      }
      apply();
      document.addEventListener("DOMContentLoaded", apply);
      document.addEventListener("astro:after-swap", apply);
      document.addEventListener("keydown", function (e) {
        var top = document.querySelector(".top.open");
        if (e.key === "Escape" && top) { top.classList.remove("open"); var k = top.querySelector("[data-menu]"); k.setAttribute("aria-expanded", "false"); k.focus(); }
      });
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", function () { if (get() === "auto") window.dispatchEvent(new Event("rrr-theme")); });
      document.addEventListener("click", function (e) {
        /* the knob menu on phones: the knob toggles it, a click outside or on a link closes it */
        var top = document.querySelector(".top:not(.bare)"), knob = e.target.closest && e.target.closest("[data-menu]");
        if (top && (knob || (top.classList.contains("open") && (!e.target.closest(".hmenu") || e.target.closest(".hmenu a"))))) {
          var open = knob ? !top.classList.contains("open") : false;
          top.classList.toggle("open", open);
          top.querySelector("[data-menu]").setAttribute("aria-expanded", String(open));
        }
        var b = e.target.closest && e.target.closest("[data-theme-set]");
        if (!b) return;
        try { localStorage.setItem("rrr-theme", b.getAttribute("data-theme-set")); } catch (e) {}
        apply();
        window.dispatchEvent(new Event("rrr-theme"));
      });
    })();
  </script>
  <ClientRouter fallback="swap" />
</head>
<body data-inst={inst?.key} data-sizes={sizes}>
  <div class="wrap">
    {home ? (
      /* the home page is the logo and the instrument picker, so its header keeps only the theme switch and the account (or progress) link */
      <header class="top bare"><ThemeSwitch /><a class="acct" href="/account" id="acct">{SIGN_IN ? "Sign in" : "Progress"}</a></header>
    ) : (
      <header class="top">
        <div class="brand"><h1><Logo /></h1></div>
        {/* on phones every option below folds into a menu opened by a knob; on wider screens the menu is just the rest of the header */}
        <button class="knob" type="button" aria-expanded="false" aria-controls="hmenu" aria-label="Menu" data-menu><svg viewBox="0 0 44 44" aria-hidden="true"><path class="kn-ring" d="M22.00 1.20 L22.54 1.28 L23.07 1.52 L23.58 1.91 L24.06 2.41 L24.50 2.99 L24.91 3.63 L25.29 4.27 L25.64 4.88 L25.98 5.43 L26.32 5.87 L26.68 6.20 L27.07 6.40 L27.50 6.47 L27.98 6.41 L28.52 6.25 L29.12 6.01 L29.76 5.73 L30.44 5.43 L31.15 5.15 L31.85 4.94 L32.53 4.81 L33.17 4.80 L33.74 4.92 L34.23 5.17 L34.62 5.56 L34.90 6.06 L35.09 6.67 L35.18 7.36 L35.20 8.10 L35.15 8.85 L35.08 9.59 L35.01 10.29 L34.96 10.93 L34.97 11.49 L35.07 11.97 L35.27 12.36 L35.58 12.67 L36.00 12.91 L36.53 13.09 L37.16 13.25 L37.85 13.40 L38.57 13.56 L39.30 13.75 L40.00 13.99 L40.62 14.29 L41.14 14.65 L41.54 15.08 L41.78 15.57 L41.87 16.11 L41.81 16.69 L41.60 17.29 L41.27 17.90 L40.85 18.51 L40.37 19.09 L39.88 19.65 L39.40 20.17 L38.99 20.66 L38.67 21.13 L38.47 21.57 L38.40 22.00 L38.47 22.43 L38.67 22.87 L38.99 23.34 L39.40 23.83 L39.88 24.35 L40.37 24.91 L40.85 25.49 L41.27 26.10 L41.60 26.71 L41.81 27.31 L41.87 27.89 L41.78 28.43 L41.54 28.92 L41.14 29.35 L40.62 29.71 L40.00 30.01 L39.30 30.25 L38.57 30.44 L37.85 30.60 L37.16 30.75 L36.53 30.91 L36.00 31.09 L35.58 31.33 L35.27 31.64 L35.07 32.03 L34.97 32.51 L34.96 33.07 L35.01 33.71 L35.08 34.41 L35.15 35.15 L35.20 35.90 L35.18 36.64 L35.09 37.33 L34.90 37.94 L34.62 38.44 L34.23 38.83 L33.74 39.08 L33.17 39.20 L32.53 39.19 L31.85 39.06 L31.15 38.85 L30.44 38.57 L29.76 38.27 L29.12 37.99 L28.52 37.75 L27.98 37.59 L27.50 37.53 L27.07 37.60 L26.68 37.80 L26.32 38.13 L25.98 38.57 L25.64 39.12 L25.29 39.73 L24.91 40.37 L24.50 41.01 L24.06 41.59 L23.58 42.09 L23.07 42.48 L22.54 42.72 L22.00 42.80 L21.46 42.72 L20.93 42.48 L20.42 42.09 L19.94 41.59 L19.50 41.01 L19.09 40.37 L18.71 39.73 L18.36 39.12 L18.02 38.57 L17.68 38.13 L17.32 37.80 L16.93 37.60 L16.50 37.53 L16.02 37.59 L15.48 37.75 L14.88 37.99 L14.24 38.27 L13.56 38.57 L12.85 38.85 L12.15 39.06 L11.47 39.19 L10.83 39.20 L10.26 39.08 L9.77 38.83 L9.38 38.44 L9.10 37.94 L8.91 37.33 L8.82 36.64 L8.80 35.90 L8.85 35.15 L8.92 34.41 L8.99 33.71 L9.04 33.07 L9.03 32.51 L8.93 32.03 L8.73 31.64 L8.42 31.33 L8.00 31.09 L7.47 30.91 L6.84 30.75 L6.15 30.60 L5.43 30.44 L4.70 30.25 L4.00 30.01 L3.38 29.71 L2.86 29.35 L2.46 28.92 L2.22 28.43 L2.13 27.89 L2.19 27.31 L2.40 26.71 L2.73 26.10 L3.15 25.49 L3.63 24.91 L4.12 24.35 L4.60 23.83 L5.01 23.34 L5.33 22.87 L5.53 22.43 L5.60 22.00 L5.53 21.57 L5.33 21.13 L5.01 20.66 L4.60 20.17 L4.12 19.65 L3.63 19.09 L3.15 18.51 L2.73 17.90 L2.40 17.29 L2.19 16.69 L2.13 16.11 L2.22 15.57 L2.46 15.08 L2.86 14.65 L3.38 14.29 L4.00 13.99 L4.70 13.75 L5.43 13.56 L6.15 13.40 L6.84 13.25 L7.47 13.09 L8.00 12.91 L8.42 12.67 L8.73 12.36 L8.93 11.97 L9.03 11.49 L9.04 10.93 L8.99 10.29 L8.92 9.59 L8.85 8.85 L8.80 8.10 L8.82 7.36 L8.91 6.67 L9.10 6.06 L9.38 5.56 L9.77 5.17 L10.26 4.92 L10.83 4.80 L11.47 4.81 L12.15 4.94 L12.85 5.15 L13.56 5.43 L14.24 5.73 L14.88 6.01 L15.48 6.25 L16.02 6.41 L16.50 6.47 L16.93 6.40 L17.32 6.20 L17.68 5.87 L18.02 5.43 L18.36 4.88 L18.71 4.27 L19.09 3.63 L19.50 2.99 L19.94 2.41 L20.42 1.91 L20.93 1.52 L21.46 1.28Z"/><circle class="kn-cap" cx="22" cy="22" r="14.5"/><line class="kn-mark" x1="22" y1="22" x2="22" y2="10" transform="rotate(45 22 22)"/></svg></button>
        <div class="hmenu" id="hmenu">
          <nav class="instr" aria-label="Instrument">
            {INSTRUMENTS.map((x) => x.ready
              ? <a href={`/${x.slug}`} aria-current={x === inst ? "page" : undefined}>{x.name}</a>
              : <span class="off">{x.name}<small>next</small></span>)}
          </nav>
          {inst?.ready && <div class="meter"><span id="meterTxt">0 / 0 steps</span><span class="bar"><i id="meterBar"></i></span></div>}
          <ThemeSwitch />
          <a class="acct" href="/account" id="acct">{SIGN_IN ? "Sign in" : "Progress"}</a>
        </div>
      </header>
    )}
    {tabs.length > 0 && (
      <nav class="tabs" aria-label="Sections">
        {tabs.map(([k, label, sub]) => <a href={`/${inst.slug}${sub}`} aria-current={tab === k ? "page" : undefined}>{label}</a>)}
      </nav>
    )}
    <main id="view"><slot /></main>
  </div>
  <footer class="foot">
    <div class="foot-in">
      <section>
        <div class="foot-brand">Rep Rep Rep</div>
        <p>Learn music by playing it, one idea at a time, on the gear you own.</p>
        <p class="foot-note"><span id="sync">Progress saved in this browser.</span></p>
      </section>
      <section>
        <h2 class="t-label">About</h2>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="https://github.com/am/repreprep">Source code on GitHub</a></li>
          <li><a href="https://github.com/am/repreprep/blob/main/CONTRIBUTING.md">Contribute a lesson or fix</a></li>
          <li>Code MIT, lessons CC BY-NC-SA 4.0</li>
        </ul>
      </section>
    </div>
  </footer>
  <script is:inline>window.__rrrLayout();</script>
  <script>import "../client/app.js";</script>
</body>
</html>
