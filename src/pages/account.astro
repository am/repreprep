---
import Base from "../layouts/Base.astro";
import Card from "../components/site/Card.astro";
import { SIGN_IN } from "../lib/features.js";
---
<Base title={SIGN_IN ? "Your account" : "Your progress"} description={SIGN_IN ? "Sign in to keep your progress on every device." : "Back up your progress or load a saved copy."}>
  <div class="page" id="account">
    <h2>Your progress</h2>
    {SIGN_IN ? (
      <Fragment>
        <p class="msg bad" data-acct-error hidden>Sign-in didn't work. Please try again.</p>
        <div data-signed-out hidden>
          <p>Your ticks, finished lessons and notes are saved in this browser. Sign in to keep them on every device. When you sign in, what you did here is added to your account. <a href="/privacy">What the site keeps</a>.</p>
          <div class="signin" data-providers></div>
          <p class="msg" data-no-providers hidden>Sign-in isn't set up on this site yet.</p>
        </div>
        <div data-signed-in hidden>
          <p>Signed in as <b data-who></b>. Your progress is saved to your account and follows you to any device where you sign in.</p>
          <div class="row"><button class="btn" data-signout>Sign out</button><a class="btn" href="/api/export" download data-astro-reload>Download my account data</a></div>
        </div>
      </Fragment>
    ) : (
      <p>Your ticks, finished lessons and notes are saved in this browser. <a href="/privacy">What the site keeps</a>.</p>
    )}
    <Card title="Back up or move your progress">
      <p class="t-body">Download a copy of your progress, or load one. A <code>progress.json</code> from the old local version of the course works too.</p>
      <div class="row">
        <button class="btn" data-export>Download progress</button>
        <label class="btn">Load a progress file<input type="file" accept="application/json,.json" data-import hidden></label>
        <span class="msg" data-import-msg></span>
      </div>
    </Card>
    <Card title="Delete your progress">
      <p class="t-body">Removes your ticks, finished lessons and notes{SIGN_IN ? " from this browser and, if you're signed in, from your account" : " from this browser"}. This can't be undone, so download a copy first if you might want it back.</p>
      <div class="row"><button class="btn danger" data-clear>Delete my progress</button><span class="msg" data-clear-msg></span></div>
    </Card>
    {SIGN_IN && (
      <Card title="Delete your account" data-signed-in hidden>
        <p class="t-body">Removes your account and everything saved with it from this site. Your progress stays in this browser. See <a href="/privacy">Privacy</a> for what the site keeps.</p>
        <div class="row"><button class="btn danger" data-delete>Delete my account</button></div>
      </Card>
    )}
  </div>
</Base>

<script>
  /* download, load and delete your progress; with sign-in on, who you are and your account */
  import { onProgress, flush, update, adopt, state, account, LS_KEY } from "../client/progress.js";
  import { esc } from "../course/shared/html.js";
  import { SIGN_IN } from "../lib/features.js";

  const PROVIDER_ICON = {
    google: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3zM12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22zm-5.6-8c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2l3.3-2.6zM12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 6 12 6z"/></svg>',
    github: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg>',
  };
  onProgress(() => {
    const root = document.getElementById("account"); if (!SIGN_IN || !root || !account.loaded) return;
    const q = new URLSearchParams(location.search), me = account.me;
    root.querySelector("[data-acct-error]").hidden = q.get("error") !== "signin";
    root.querySelectorAll("[data-signed-in]").forEach((el) => (el.hidden = !me));
    root.querySelectorAll("[data-signed-out]").forEach((el) => (el.hidden = !!me));
    if (me) root.querySelector("[data-who]").textContent = [me.name, me.email && `(${me.email})`].filter(Boolean).join(" ");
    else {
      const box = root.querySelector("[data-providers]");
      const next = q.get("next") || "/account";
      box.innerHTML = account.providers.map((p) => `<a class="btn" href="/auth/${p.id}?next=${encodeURIComponent(next)}" data-astro-reload>${PROVIDER_ICON[p.id] || ""}Continue with ${esc(p.name)}</a>`).join("");
      root.querySelector("[data-no-providers]").hidden = account.providers.length > 0;
    }
  });

  async function signOut() {
    await flush();
    await fetch("/auth/logout", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" }).catch(() => {});
    /* a shared computer shouldn't keep your progress after you sign out */
    try { localStorage.removeItem(LS_KEY); } catch (e) {}
    location.href = "/account";
  }
  async function deleteAccount() {
    if (!confirm("Delete your account and the progress saved with it? This can't be undone.")) return;
    const r = await fetch("/api/me", { method: "DELETE", headers: { "Content-Type": "application/json" } }).catch(() => null);
    if (r && r.ok) { account.me = null; location.href = "/account"; } else alert("Couldn't delete the account. Please try again.");
  }
  function exportProgress() {
    const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
    const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(blob), download: "repreprep-progress.json" });
    a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }
  /* clears ticks, finished lessons and notes; layout choices stay */
  function clearProgress() {
    if (!confirm("Delete your progress? Your ticks, finished lessons and notes will be removed. Download a copy first if you might want them back.")) return;
    state.inst = {};
    update();
    const msg = document.querySelector("[data-clear-msg]"); if (msg) msg.textContent = "Progress deleted.";
  }
  async function importProgress(file) {
    const msg = document.querySelector("[data-import-msg]");
    try {
      const s = JSON.parse(await file.text());
      if (!s || typeof s.inst !== "object") throw new Error("not a progress file");
      adopt(s);
      update();
      const n = Object.values(state.inst).reduce((a, v) => a + Object.keys(v.steps || {}).length, 0);
      if (msg) msg.textContent = `Loaded. ${n} ticked steps.`;
    } catch (e) { if (msg) msg.textContent = "That file isn't a Rep Rep Rep progress file."; }
  }
  document.addEventListener("click", (e) => {
    if (e.target.closest("[data-signout]")) signOut();
    else if (e.target.closest("[data-delete]")) deleteAccount();
    else if (e.target.closest("[data-export]")) exportProgress();
    else if (e.target.closest("[data-clear]")) clearProgress();
  });
  document.addEventListener("change", (e) => { const f = e.target.closest("[data-import]"); if (f && f.files[0]) { importProgress(f.files[0]); f.value = ""; } });
</script>

<style>
  .signin{display:flex;flex-direction:column;gap:var(--s2);max-width:20rem;margin:var(--s4) 0}
  .signin :global(.btn){justify-content:flex-start;gap:var(--s3)}
  .signin :global(svg){width:1.125rem;height:1.125rem}
</style>
