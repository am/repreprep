---
import Base from "../layouts/Base.astro";
import Card from "../components/site/Card.astro";
import { SIGN_IN, TURNSTILE_SITE_KEY } from "astro:env/client";
---

<Base
  noindex
  title={SIGN_IN ? "Your account" : "Your progress"}
  description={
    SIGN_IN ? "Sign in to keep your progress on every device." : "Back up your progress or load a saved copy."
  }
>
  <div class="page" id="account">
    <h2>Your progress</h2>
    {SIGN_IN ? (
      <Fragment>
        <p class="msg bad" data-acct-error hidden>
          Sign-in didn't work. Please try again.
        </p>
        <div data-signed-out hidden>
          <p>
            Your ticks, finished lessons and notes are saved in this browser. Sign in to keep them on every device. When
            you sign in, what you did here is added to your account. <a href="/privacy">What the site keeps</a>.
          </p>
          <div class="signin" data-providers></div>
          <form class="email-signin" data-email-signin data-mode="link" data-astro-reload hidden>
            <label>
              Or sign in with your email
              <input
                type="email"
                name="email"
                required
                maxlength="200"
                autocomplete="email"
                placeholder="you@example.com"
              />
            </label>
            <label data-password-part>
              Password (at least 10 characters)
              <input type="password" name="password" minlength="10" maxlength="128" autocomplete="current-password" />
            </label>
            <div
              class="turnstile"
              data-turnstile={import.meta.env.DEV ? "1x00000000000000000000AA" : TURNSTILE_SITE_KEY}
            ></div>
            <div class="row" data-link-part>
              <button class="btn primary" type="submit" data-act="link">
                Email me a link
              </button>
              <button class="btn" type="button" data-mode-to="password" data-password-option>
                Use a password instead
              </button>
            </div>
            <div class="row" data-password-part>
              <button class="btn primary" type="submit" data-act="signin">
                Sign in
              </button>
              <button class="btn" type="submit" data-act="signup">
                Create account
              </button>
              <button class="btn" type="submit" data-act="forgot" formnovalidate>
                Forgot password?
              </button>
            </div>
            <p class="t-body" data-password-part>
              <button class="linkish" type="button" data-mode-to="link">
                Email me a link instead
              </button>
            </p>
            <p class="msg" data-email-msg role="status"></p>
          </form>
          <p class="msg" data-no-providers hidden>
            Sign-in isn't set up on this site yet.
          </p>
        </div>
        <div data-signed-in hidden>
          <p>
            Signed in as <b data-who></b>. Your progress is saved to your account and follows you to any device where
            you sign in.
          </p>
          <div class="row">
            <button class="btn" data-signout>
              Sign out
            </button>
            <a class="btn" href="/api/export" download data-astro-reload>
              Download my account data
            </a>
          </div>
        </div>
      </Fragment>
    ) : (
      <p>
        Your ticks, finished lessons and notes are saved in this browser. <a href="/privacy">What the site keeps</a>.
      </p>
    )}
    <Card title="Back up or move your progress">
      <p class="t-body">
        Download a copy of your progress, or load one, for example to move it to another device. Loading a file adds it
        to the progress already in this browser, so nothing done here is lost. A <code>progress.json</code> from the old
        local version of the course works too.
      </p>
      <div class="row">
        <button class="btn" data-export>
          Download progress
        </button>
        <label class="btn">
          Load a progress file
          <input type="file" accept="application/json,.json" data-import hidden />
        </label>
        <span class="msg" data-import-msg></span>
      </div>
    </Card>
    <Card title="Delete your progress">
      <p class="t-body">
        Removes your ticks, finished lessons and notes
        {SIGN_IN ? " from this browser and, if you're signed in, from your account" : " from this browser"}. This can't
        be undone, so download a copy first if you might want it back.
      </p>
      <div class="row">
        <button class="btn danger" data-clear>
          Delete my progress
        </button>
        <span class="msg" data-clear-msg></span>
      </div>
    </Card>
    {SIGN_IN && (
      <Card title="Delete your account" data-signed-in hidden>
        <p class="t-body">
          Removes your account and everything saved with it from this site. Your progress stays in this browser. See{" "}
          <a href="/privacy">Privacy</a> for what the site keeps.
        </p>
        <div class="row">
          <button class="btn danger" data-delete>
            Delete my account
          </button>
        </div>
      </Card>
    )}
  </div>
</Base>

<script>
  /* download, load and delete your progress; with sign-in on, who you are and your account */
  import { onProgress, flush, update, combine, state, account, LS_KEY } from "../client/progress.js";
  import { drawTurnstile, resetTurnstile } from "../client/turnstile.js";
  import { esc } from "../course/shared/html.js";
  import { SIGN_IN } from "astro:env/client";

  const PROVIDER_ICON = {
    google:
      '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3zM12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22zm-5.6-8c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2l3.3-2.6zM12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 6 12 6z"/></svg>',
  };
  onProgress(() => {
    const root = document.getElementById("account");
    if (!SIGN_IN || !root || !account.loaded) return;
    const q = new URLSearchParams(location.search),
      me = account.me;
    root.querySelector("[data-acct-error]").hidden = q.get("error") !== "signin";
    root.querySelectorAll("[data-signed-in]").forEach((el) => (el.hidden = !me));
    root.querySelectorAll("[data-signed-out]").forEach((el) => (el.hidden = !!me));
    if (me)
      root.querySelector("[data-who]").textContent = [me.name, me.email && `(${me.email})`].filter(Boolean).join(" ");
    else {
      const box = root.querySelector("[data-providers]");
      const next = q.get("next") || "/account";
      const links = account.providers.filter((p) => !["email", "password"].includes(p.id));
      const form = root.querySelector("[data-email-signin]");
      form.hidden = !account.providers.some((p) => p.id === "email");
      form.querySelector("[data-password-option]").hidden = !account.providers.some((p) => p.id === "password");
      if (!form.hidden) drawTurnstile(form.querySelector("[data-turnstile]"));
      box.innerHTML = links
        .map(
          (p) =>
            `<a class="btn" href="/auth/${p.id}?next=${encodeURIComponent(next)}" data-astro-reload>${PROVIDER_ICON[p.id] || ""}Continue with ${esc(p.name)}</a>`
        )
        .join("");
      root.querySelector("[data-no-providers]").hidden = account.providers.length > 0;
    }
  });

  /* the email form: a one-use sign-in link (the default), or a password. Each request goes to Better Auth with the
     Turnstile token; what comes back is said in plain words under the form. */
  const API = {
    link: "/api/auth/sign-in/magic-link",
    signin: "/api/auth/sign-in/email",
    signup: "/api/auth/sign-up/email",
    forgot: "/api/auth/request-password-reset",
  };
  const ERRORS = {
    PASSWORD_COMPROMISED: "That password has turned up in a data breach, so it's easy to guess. Please choose another.",
    PASSWORD_TOO_SHORT: "Please use a password of at least 10 characters.",
    PASSWORD_TOO_LONG: "Please use a password of at most 128 characters.",
    INVALID_EMAIL_OR_PASSWORD: "That email and password don't match. Try again, or use “Forgot password?”.",
    INVALID_EMAIL: "That doesn't look like an email address.",
  };
  async function sendEmailForm(form, act) {
    const msg = form.querySelector("[data-email-msg]");
    const email = form.email.value.trim();
    const password = form.password.value;
    /* only a path on this site, never another address */
    const asked = new URLSearchParams(location.search).get("next") || "";
    const next = /^\/(?![\/\\])/.test(asked) && !asked.includes("\\") ? asked : "/account";
    const body = {
      link: { email, callbackURL: next, errorCallbackURL: "/account?error=signin" },
      signin: { email, password, callbackURL: next },
      signup: { email, password, name: email.split("@")[0], callbackURL: next },
      forgot: { email, redirectTo: "/account/reset" },
    }[act];
    const token = form.querySelector('[name="cf-turnstile-response"]')?.value || "";
    form.querySelectorAll("button").forEach((b) => (b.disabled = true));
    msg.className = "msg";
    msg.textContent = "One moment…";
    const r = await fetch(API[act], {
      method: "POST",
      headers: { "Content-Type": "application/json", "x-captcha-response": token },
      body: JSON.stringify(body),
    }).catch(() => null);
    const j = await r?.json().catch(() => ({}));
    form.querySelectorAll("button").forEach((b) => (b.disabled = false));
    resetTurnstile(form.querySelector("[data-turnstile]"));
    const say = (text, bad) => {
      msg.className = bad ? "msg bad" : "msg";
      msg.textContent = text;
    };
    if (r?.ok) {
      if (act === "signin") return (location.href = next);
      form.password.value = "";
      return say(
        {
          link: `Check your inbox: a sign-in link is on its way to ${email}. It works once, for 10 minutes.`,
          signup: `Almost there: confirm your address with the link we sent to ${email}, and you're signed in.`,
          forgot: `If there's an account for ${email}, a link to choose a new password is on its way. It works for an hour.`,
        }[act]
      );
    }
    if (r?.status === 429) return say("Too many tries. Please wait a minute and try again.", true);
    if (j?.code === "EMAIL_NOT_VERIFIED")
      return say(`Please confirm your address first: we've sent a new link to ${email}.`, true);
    if (ERRORS[j?.code]) return say(ERRORS[j.code], true);
    if (r?.status === 400 || r?.status === 403)
      return say("That didn't go through. Check the address and the box above, then try again.", true);
    say("Something went wrong. Please try again.", true);
  }
  document.addEventListener("submit", (e) => {
    const f = e.target.closest("[data-email-signin]");
    if (!f) return;
    e.preventDefault();
    const act = e.submitter?.dataset.act || (f.dataset.mode === "password" ? "signin" : "link");
    if ((act === "signin" || act === "signup") && f.password.value.length < 10) {
      f.password.focus();
      return f.password.reportValidity?.() || undefined;
    }
    sendEmailForm(f, act);
  });
  document.addEventListener("click", (e) => {
    const b = e.target.closest("[data-mode-to]");
    if (!b) return;
    const f = b.closest("[data-email-signin]");
    f.dataset.mode = b.dataset.modeTo;
    f.querySelector("[data-email-msg]").textContent = "";
    (f.dataset.mode === "password" ? f.password : f.email).focus();
  });

  async function signOut() {
    await flush();
    const { actions } = await import("astro:actions");
    await actions.account.signOut().catch(() => {});
    /* a shared computer shouldn't keep your progress after you sign out */
    try {
      localStorage.removeItem(LS_KEY);
    } catch (e) {}
    location.href = "/account";
  }
  async function deleteAccount() {
    if (!confirm("Delete your account and the progress saved with it? This can't be undone.")) return;
    const { actions } = await import("astro:actions");
    const { error } = await actions.account.delete().catch((e) => ({ error: e }));
    if (!error) {
      account.me = null;
      location.href = "/account";
    } else alert("Couldn't delete the account. Please try again.");
  }
  function exportProgress() {
    const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
    const a = Object.assign(document.createElement("a"), {
      href: URL.createObjectURL(blob),
      download: "repreprep-progress.json",
    });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }
  /* clears ticks, finished lessons and notes; layout choices stay */
  function clearProgress() {
    if (
      !confirm(
        "Delete your progress? Your ticks, finished lessons and notes will be removed. Download a copy first if you might want them back."
      )
    )
      return;
    state.inst = {};
    update();
    const msg = document.querySelector("[data-clear-msg]");
    if (msg) msg.textContent = "Progress deleted.";
  }
  async function importProgress(file) {
    const msg = document.querySelector("[data-import-msg]");
    try {
      const s = JSON.parse(await file.text());
      if (!s || typeof s.inst !== "object") throw new Error("not a progress file");
      combine(s);
      update();
      const n = Object.values(state.inst).reduce((a, v) => a + Object.keys(v.steps || {}).length, 0);
      if (msg) msg.textContent = `Loaded and combined. ${n} ticked steps.`;
    } catch (e) {
      if (msg) msg.textContent = "That file isn't a Rep Rep Rep progress file.";
    }
  }
  document.addEventListener("click", (e) => {
    if (e.target.closest("[data-signout]")) signOut();
    else if (e.target.closest("[data-delete]")) deleteAccount();
    else if (e.target.closest("[data-export]")) exportProgress();
    else if (e.target.closest("[data-clear]")) clearProgress();
  });
  document.addEventListener("change", (e) => {
    const f = e.target.closest("[data-import]");
    if (f && f.files[0]) {
      importProgress(f.files[0]);
      f.value = "";
    }
  });
</script>

<style>
  .signin {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    max-width: 20rem;
    margin: var(--s4) 0;
  }
  .signin :global(.btn) {
    justify-content: flex-start;
    gap: var(--s3);
  }
  .signin :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }
  .email-signin {
    max-width: 24rem;
    margin: 0 0 var(--s4);
  }
  .email-signin label {
    display: block;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .email-signin input {
    display: block;
    width: 100%;
    margin-top: var(--s2);
    padding: var(--s3);
    border-radius: var(--r-m);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: var(--fs-sm);
  }
  .email-signin .turnstile {
    margin: 10px 0;
    min-height: 65px;
  }
  .email-signin[data-mode="link"] [data-password-part],
  .email-signin[data-mode="password"] [data-link-part] {
    display: none;
  }
  .email-signin label + label {
    margin-top: var(--s3);
  }
  .email-signin .linkish {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .email-signin .msg {
    margin-top: var(--s2);
  }
  .email-signin .msg:empty {
    display: none;
  }
</style>
