---
import Base from "../layouts/Base.astro";
---
<Base title="Your account" description="Sign in to keep your progress on every device.">
  <div class="page" id="account">
    <h2>Your progress</h2>
    <p class="msg bad" data-acct-error hidden>Sign-in didn't work. Please try again.</p>
    <div data-signed-out hidden>
      <p>Your ticks, finished lessons and notes are saved in this browser. Sign in to keep them on every device. When you sign in, what you did here is added to your account.</p>
      <div class="signin" data-providers></div>
      <p class="msg" data-no-providers hidden>Sign-in isn't set up on this site yet.</p>
    </div>
    <div data-signed-in hidden>
      <p>Signed in as <b data-who></b>. Your progress is saved to your account and follows you to any device where you sign in.</p>
      <div class="row"><button class="btn" data-signout>Sign out</button></div>
    </div>
    <section class="box">
      <h3>Back up or move your progress</h3>
      <p class="msg">Download a copy of your progress, or load one. A <code>progress.json</code> from the old local version of the course works too.</p>
      <div class="row">
        <button class="btn" data-export>Download progress</button>
        <label class="btn">Load a progress file<input type="file" accept="application/json,.json" data-import hidden></label>
        <span class="msg" data-import-msg></span>
      </div>
    </section>
    <section class="box" data-signed-in hidden>
      <h3>Delete your account</h3>
      <p class="msg">Removes your account and everything saved with it from this site. Your progress stays in this browser.</p>
      <div class="row"><button class="btn" data-delete>Delete my account</button></div>
    </section>
  </div>
</Base>
