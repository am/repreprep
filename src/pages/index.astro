---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { INSTRUMENTS } from "../course/index.js";
const count = (I: any) => {
  const songs = I.lessons.filter((l: any) => l.song).length;
  return `${I.lessons.length - songs} lessons · ${songs} song studies`;
};
---
<Base home>
  <section class="hero">
    <h1 class="mark"><Logo /></h1>
    <h2>Learn music by playing it.</h2>
    <p>Short lessons on the gear you own. One idea at a time, rep after rep.</p>
    <nav class="gear" aria-label="Pick your instrument">
      {INSTRUMENTS.map((I) => I.ready
        ? <a class="go" href={`/${I.slug}`}><b>{I.name}</b><small>{count(I)}</small></a>
        : <span class="soon"><b>{I.name}</b><small>coming next</small></span>)}
    </nav>
  </section>
</Base>
