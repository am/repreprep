---
import Base from "../layouts/Base.astro";
import Logo from "../components/site/Logo.astro";
import { catalog } from "../course/content.js";
const instruments = await catalog();
const count = (I: any) => {
  const songs = I.lessons.filter((l: any) => l.song).length;
  return `${I.lessons.length - songs} lessons · ${songs} song studies`;
};
---

<Base home fullTitle="Rep Rep Rep · Learn music production on the gear you own">
  <div class="home" id="home">
    <section class="scene">
      <h1 class="mark">
        <Logo dance />
      </h1>
      <span class="cue" aria-hidden="true"></span>
    </section>
    <section class="scene">
      <h2>Learn music by playing it.</h2>
      <p>One idea at a time, in short lessons on the gear you own.</p>
    </section>
    <section class="scene">
      <h2>Rep after rep.</h2>
      <nav class="gear" aria-label="Pick your instrument">
        {instruments.map((I) =>
          I.ready ? (
            <a class="go" href={`/${I.slug}`}>
              <b>{I.name}</b>
              <small>{count(I)}</small>
            </a>
          ) : (
            <span class="soon">
              <b>{I.name}</b>
              <small>coming next</small>
            </span>
          )
        )}
      </nav>
    </section>
  </div>
</Base>
<script is:inline data-astro-rerun>
  (function () {
    var home = document.getElementById("home");
    if (!home || !("IntersectionObserver" in window)) return;
    home.classList.add("anim");
    var io = new IntersectionObserver(
      function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    home.querySelectorAll(".scene").forEach(function (s) {
      io.observe(s);
    });
    function onScroll() {
      if (!home.isConnected) return removeEventListener("scroll", onScroll);
      home.classList.toggle("scrolled", scrollY > 40);
    }
    addEventListener("scroll", onScroll, { passive: true });
  })();
</script>

<style>
  /* home: one idea per screen, each centered in the viewport, revealed as you scroll.
     The instrument picker at the end is the page's only set of links into the course. */
  .scene {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12vh 0;
    position: relative;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .scene:first-child {
    padding-top: 0;
  }
  /* each scene snaps into place; the footer gets its own snap point so it stays reachable */
  :global(html:has(.home)) {
    scroll-snap-type: y mandatory;
  }
  :global(body:has(.home) .foot) {
    scroll-snap-align: end;
  }
  .scene .mark :global(.logo) {
    transform-origin: 50% 55%;
  }
  .scene .mark {
    font-size: var(--fs-mark);
    line-height: 0.82;
    margin: 0;
  }
  .scene h2 {
    font-size: var(--fs-hero);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 13ch;
  }
  .scene p {
    margin: 0.9em 0 0;
    font-size: var(--fs-lede);
    color: var(--muted);
    max-width: 30ch;
  }
  /* scroll hint: a thin line with a dot sliding down it */
  .cue {
    position: absolute;
    bottom: 5vh;
    left: 50%;
    width: 1px;
    height: 3.5rem;
    margin-left: -0.5px;
    background: var(--line);
    overflow: hidden;
    transition: opacity 0.4s ease;
  }
  .cue::after {
    content: "";
    position: absolute;
    left: -2px;
    top: -6px;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--fg);
    animation: cue 2.2s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateY(3.875rem);
      opacity: 0;
    }
  }
  .scrolled .cue {
    opacity: 0;
  }
  /* reveal: only once the script has run, so the page reads fine without it */
  .home.anim .scene > *:not(.cue) {
    opacity: 0;
    transform: translateY(1.75rem);
    transition:
      opacity 0.9s ease,
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .home.anim .scene > *:nth-child(2) {
    transition-delay: 0.12s;
  }
  .home.anim .scene > *:nth-child(3) {
    transition-delay: 0.24s;
  }
  .home.anim .scene.in > *:not(.cue) {
    opacity: 1;
    transform: none;
  }
  .gear {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s3);
    margin-top: clamp(var(--s6), 6vh, var(--s8));
  }
  .gear a,
  .gear span {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s4) var(--s5);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    text-decoration: none;
    color: inherit;
  }
  .gear b {
    font-family: var(--display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-xl);
  }
  .gear small {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-key);
    color: var(--muted);
  }
  .gear a {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    transition: transform 0.15s ease;
  }
  .gear a small {
    color: inherit;
    opacity: 0.7;
  }
  .gear a:hover {
    transform: translateY(-2px);
  }
  .gear .soon {
    opacity: 0.5;
  }
  @media (max-width: 616px) {
    .scene .mark {
      font-size: 40vw;
    }
    .gear {
      width: 100%;
    }
    .gear a {
      flex: 1 1 100%;
    }
    .gear span {
      flex: 1 1 40%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gear a {
      transition: none;
    }
    .cue::after {
      animation: none;
      top: 1.5rem;
      opacity: 1;
    }
    .home.anim .scene > *:not(.cue) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
