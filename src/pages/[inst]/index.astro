---
import Base from "../../layouts/Base.astro";
import CourseMap from "../../components/course/CourseMap.astro";
import { courses } from "../../course/content.js";
export async function getStaticPaths() {
  return (await courses()).map((I) => ({ params: { inst: I.slug }, props: { I } }));
}
const { I } = Astro.props;
const first = I.lessons[0];
const units = [...new Set(I.lessons.filter((l) => !l.song).map((l) => l.unit))];
const songs = I.lessons.filter((l) => l.song).length;
---
<Base title={`${I.name} course`} description={`${I.lessons.filter((l) => !l.song).length} hands-on lessons on the ${I.name}: ${units.join(", ").toLowerCase()}.`} inst={I} tab="lessons">
  <div class="page">
    <div class="t-eyebrow">{I.name} course</div>
    <h2>Learn music production on your {I.name}</h2>
    <p class="goal">{I.lessons.filter((l) => !l.song).length} lessons in {units.length} parts ({units.join(", ")}), plus {songs} song studies. Each lesson teaches one idea with drawings and playable examples, then you practise it on the device, click by click.</p>
    <div class="row">
      <a class="btn primary" href={first.path} data-continue data-label-start="Start lesson 1" data-label-continue="Continue">Start lesson 1</a>
      <span class="msg" data-continue-what></span>
    </div>
  </div>
  <nav class="umap bands" aria-label="Lessons"><CourseMap I={I} /></nav>
</Base>

<script>
  /* Continue opens the lesson you were on, at the step you were on */
  import { onProgress, here, stepHref } from "../../client/progress.js";
  onProgress(() => {
    const c = document.querySelector("[data-continue]"), s = here(); if (!c || !s) return;
    const cur = [...document.querySelectorAll(".umap a[data-lesson]")].find((a) => a.dataset.lesson === s.lesson);
    if (cur && Object.keys(s.steps).length) {
      c.href = stepHref(cur.dataset.path, s.active[s.lesson] || 0);
      c.textContent = c.dataset.labelContinue;
      const w = document.querySelector("[data-continue-what]"); if (w) w.textContent = cur.querySelector(".n").textContent + " · " + cur.querySelector(".t").childNodes[0].textContent;
    }
  });
</script>

<style>
  .goal{margin:0;font-size:var(--fs-lg);color:var(--fg);max-width:65ch}
  .umap{margin-top:var(--s7)}
</style>
