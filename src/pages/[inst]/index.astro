---
import Base from "../../layouts/Base.astro";
import CourseMap from "../../components/course/CourseMap.astro";
import { READY } from "../../course/index.js";
export function getStaticPaths() {
  return READY.map((I) => ({ params: { inst: I.slug }, props: { I } }));
}
const { I } = Astro.props;
const first = I.lessons[0];
const units = [...new Set(I.lessons.filter((l) => !l.song).map((l) => l.unit))];
const songs = I.lessons.filter((l) => l.song).length;
---
<Base title={`${I.name} course`} description={`${I.lessons.filter((l) => !l.song).length} hands-on lessons on the ${I.name}: ${units.join(", ").toLowerCase()}.`} inst={I} tab="lessons">
  <div class="page">
    <div class="t-eyebrow">{I.name} course</div>
    <h2>Learn music production on your {I.name}</h2>
    <p class="goal">{I.lessons.filter((l) => !l.song).length} lessons in {units.length} parts ({units.join(", ")}), plus {songs} song studies. Each lesson teaches one idea with drawings and playable examples, then you practise it on the device, click by click.</p>
    <div class="row">
      <a class="btn primary" href={first.path} data-continue data-label-start="Start lesson 1" data-label-continue="Continue">Start lesson 1</a>
      <span class="msg" data-continue-what></span>
    </div>
  </div>
  <nav class="umap bands" aria-label="Lessons"><CourseMap I={I} /></nav>
</Base>
