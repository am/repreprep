---
import Base from "../../layouts/Base.astro";
import { INSTRUMENTS } from "../../course/index.js";
import { machines } from "../../course/views.js";
export function getStaticPaths() {
  return INSTRUMENTS.filter((I) => I.ready && I.machines).map((I) => ({ params: { inst: I.slug }, props: { I } }));
}
const { I } = Astro.props;
---
<Base title={`${I.name} machines`} inst={I} tab="machines"><Fragment set:html={machines(I)} /></Base>
