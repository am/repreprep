---
import Base from "../../layouts/Base.astro";
import Band from "../../components/site/Band.astro";
import Keys from "../../components/course/Keys.astro";
import { courses } from "../../course/content.js";
export async function getStaticPaths() {
  return (await courses()).filter((I) => I.machines).map((I) => ({ params: { inst: I.slug }, props: { I } }));
}
const { I } = Astro.props;
const [commonEyebrow, commonTitle, COMMON] = I.machinesCommon;
---

<Base title={`${I.name} ${I.machinesTab.toLowerCase()}`} inst={I} tab="machines">
  <p class="lede t-body">{I.machinesIntro}</p>
  <div class="bands">
    {I.machines.map((m: any) => (
      <Band eyebrow={m.tag} title={m.n}>
        <p class="t-body">
          <Keys I={I} text={m.p} />
        </p>
        <dl class="spec">
          {Object.entries(m.m).map(([k, v]) => (
            <Fragment>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </Fragment>
          ))}
        </dl>
      </Band>
    ))}
    <Band eyebrow={commonEyebrow} title={commonTitle}>
      <dl class="spec">
        {COMMON.map(([k, v]) => (
          <Fragment>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </Fragment>
        ))}
      </dl>
    </Band>
  </div>
</Base>

<style>
  .spec {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s2) var(--s5);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .spec dt {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--fg);
    padding-top: 2px;
  }
  .spec dd {
    margin: 0;
  }
</style>
