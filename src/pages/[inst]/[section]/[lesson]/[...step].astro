---
import Base from "../../../../layouts/Base.astro";
import Player from "../../../../components/course/Player.astro";
import LessonWrapup from "../../../../components/course/LessonWrapup.astro";
import LessonAbout from "../../../../components/course/LessonAbout.astro";
import { courses } from "../../../../course/content.js";
/* /model-cycles/lessons/<lesson> (or /songs/<study>) is the intro; .../<n> is step n; one past the last step is the optional challenge;
   .../done is the screen Next opens after the last step */
export async function getStaticPaths() {
  return (await courses()).flatMap((instrument) =>
    instrument.lessons.flatMap((lesson) => {
      const params = { inst: instrument.slug, section: lesson.song ? "songs" : "lessons", lesson: lesson.slug };
      return [
        ...[...lesson.steps.keys(), ...(lesson.challenge ? [lesson.steps.length] : [])].map((index) => ({
          params: { ...params, step: index ? String(index) : undefined },
          props: { instrument, lesson, at: index },
        })),
        {
          params: { ...params, step: "done" },
          props: { instrument, lesson, at: lesson.steps.length + (lesson.challenge ? 1 : 0), done: true },
        },
      ];
    })
  );
}
const { instrument, lesson, at, done } = Astro.props;
// names the device and, for a song study, the artist and track, since that is what people search for
const title =
  (lesson.song
    ? `${lesson.song}: song study on the ${instrument.name}`
    : `${instrument.name} lesson ${lesson.number}: ${lesson.title}`) +
  (done ? " (done)" : at === lesson.steps.length ? " (challenge)" : at ? ` (${at + 1}/${lesson.steps.length})` : "");
---

<!-- only the lesson's intro is listed in search results; its steps are reached from there -->
<Base title={title} description={lesson.goal} inst={instrument} tab="lessons" noindex={at > 0 || done}>
  <Player instrument={instrument} lesson={lesson} at={at} done={done} />
  <div class="below">
    {!at && <LessonAbout I={instrument} L={lesson} />}
    {!done && <LessonWrapup I={instrument} L={lesson} />}
  </div>
</Base>

<style>
  /* lesson page: full-height step player on top, then the lesson text, then the whole course as bands */
  .below {
    margin-top: var(--s6);
  }
</style>
