---
import Base from "../../../../layouts/Base.astro";
import Player from "../../../../components/course/Player.astro";
import LessonWrapup from "../../../../components/course/LessonWrapup.astro";
import { READY, lessonLabel } from "../../../../course/index.js";
/* /model-cycles/lessons/<lesson> (or /songs/<study>) is the intro; .../<n> is step n; one past the last step is the optional challenge */
export function getStaticPaths() {
  return READY.flatMap((I) =>
    I.lessons.flatMap((L) =>
      [...L.steps.keys(), ...(L.challenge ? [L.steps.length] : [])].map((i) => ({
        params: { inst: I.slug, section: L.song ? "songs" : "lessons", lesson: L.slug, step: i ? String(i) : undefined },
        props: { I, L, act: i },
      }))));
}
const { I, L, act } = Astro.props;
const title = `${lessonLabel(L)}: ${L.title}` + (act === L.steps.length ? " (challenge)" : act ? ` (${act + 1}/${L.steps.length})` : "");
---
<Base title={title} description={L.goal} inst={I} tab="lessons">
  <Player I={I} L={L} act={act} />
  <div class="below"><LessonWrapup I={I} L={L} /></div>
</Base>
