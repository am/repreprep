---
import Base from "../../layouts/Base.astro";
import Keys from "../../components/course/Keys.astro";
import { READY } from "../../course/index.js";
export function getStaticPaths() {
  return READY.filter((I) => I.shortcuts).map((I) => ({ params: { inst: I.slug }, props: { I } }));
}
const { I } = Astro.props;
---
<Base title={`${I.name} shortcuts`} inst={I} tab="shortcuts">
  <p class="lede t-body">The combinations you'll use most, from the manual's key-shortcut list.</p>
  <div class="tblwrap"><table class="sc"><tbody>{I.shortcuts.map(([a, b]: string[]) => <tr><td>{a}</td><td><Keys I={I} text={b} /></td></tr>)}</tbody></table></div>
</Base>
