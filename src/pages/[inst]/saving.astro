---
import Base from "../../layouts/Base.astro";
import Band from "../../components/site/Band.astro";
import Keys from "../../components/course/Keys.astro";
import { courses } from "../../course/content.js";
export async function getStaticPaths() {
  return (await courses())
    .filter((I) => I.slug === "model-cycles")
    .map((I) => ({ params: { inst: I.slug }, props: { I } }));
}
const { I } = Astro.props;
const STEPS = Array.from({ length: 16 }, (_, i) => i + 1);
// the drawn pattern: which steps play on each track
const TRACKS: [string, number[]][] = [
  ["T1", [1, 5, 9, 13]],
  ["T2", [5, 13]],
  ["T3", [3, 7, 11, 15]],
  ["T4", [4, 12]],
  ["T5", [1, 4, 7, 13]],
  ["T6", [1, 9]],
];
const SAVES = [
  [
    "Automatic",
    "Every change",
    "Each knob turn and trig is kept in the machine straight away. It survives switching off only if you hold [MAIN VOLUME] to do it. Pull the plug and you get the last saved version back.",
  ],
  [
    "Temporary",
    "Snapshot",
    "Tap [FUNC] + [SETTINGS] before trying something wild, and tap [FUNC] + [PATTERN] to go back to it. The snapshot is gone when you load another project.",
  ],
  [
    "Permanent",
    "Save",
    "Hold [FUNC] + [SETTINGS] for a second to save the pattern, and hold [FUNC] + [PATTERN] to go back to the saved version. The first time, save the project itself: [SETTINGS], then PROJECT, then SAVE.",
  ],
  [
    "On your computer",
    "Backup",
    "Elektron's free Transfer app copies your projects and sounds to a computer over USB.",
  ],
  [
    "Not saved",
    "Chains",
    "A chain of patterns is lost when you switch off or pick another pattern. There is no song mode, so write the order down or record it into Live.",
  ],
];
---

<Base title={`${I.name} saving`} inst={I} tab="saving">
  <p class="lede t-body">
    What sits inside what, and when your work is saved. From Elektron’s Model:Cycles manual (OS 1.13).
  </p>

  <h3 class="sec t-label">What sits inside what</h3>
  <div class="bands">
    <Band eyebrow="Up to 96" title="Projects">
      <p class="t-body">
        The machine’s memory, the <b>+Drive</b>, keeps your projects. Think of a project as a song file: one is open at
        a time.
      </p>
      <div class="slots" aria-hidden="true">
        <span class="on">01</span>
        <span>02</span>
        <span>03</span>
        <span>04</span>
        <span>…</span>
        <span>96</span>
      </div>
    </Band>
    <Band eyebrow="Inside a project" title="6 banks">
      <p class="t-body">
        Banks A to F. Pick one with <Keys I={I} text="[PATTERN] + [T1]…[T6]" />.
      </p>
      <div class="banks" aria-hidden="true">
        {["A", "B", "C", "D", "E", "F"].map((b, i) => (
          <span class={i === 1 ? "on" : ""}>
            {b}
            <small>T{i + 1}</small>
          </span>
        ))}
      </div>
    </Band>
    <Band eyebrow="Inside a bank" title="16 patterns">
      <p class="t-body">
        Pick one with <Keys I={I} text="[PATTERN] + [TRIG 1]…[TRIG 16]" />. The course track lives in B01.
      </p>
      <div class="pats" aria-hidden="true">
        {STEPS.map((n) => (
          <span class={n === 1 ? "on" : ""}>{String(n).padStart(2, "0")}</span>
        ))}
      </div>
    </Band>
    <Band eyebrow="Inside a pattern" title="6 tracks">
      <p class="t-body">
        Each track has its own sound, called a <b>preset</b>, and its trigs. The pattern also keeps the tempo, length,
        swing, and delay and reverb settings.
      </p>
      <div class="trk" aria-hidden="true">
        {TRACKS.map(([t, on]) => (
          <div class="row">
            <span class="t">{t}</span>
            <span class="steps">
              {STEPS.map((n) => (
                <i class={on.includes(n) ? "x" : ""} />
              ))}
            </span>
          </div>
        ))}
      </div>
    </Band>
    <Band eyebrow="Also on the +Drive" title="Sound library">
      <p class="t-body">
        Sounds you keep for any project. Open it with <Keys I={I} text="[FUNC] + [MACHINES]" />. Loading a sound puts a{" "}
        <b>copy</b> on the track, so tweaking it there leaves the library version as it was.
      </p>
    </Band>
  </div>

  <h3 class="sec t-label">When it’s saved</h3>
  <div class="bands">
    {SAVES.map(([eyebrow, title, text]) => (
      <Band eyebrow={eyebrow} title={title}>
        <p class="t-body">
          <Keys I={I} text={text} />
        </p>
      </Band>
    ))}
  </div>
</Base>

<style>
  .sec {
    margin: var(--s7) 0 var(--s3);
  }
  .lede + .sec {
    margin-top: var(--s5);
  }
  /* drawings: open marks on hairlines, no boxes; the lit item uses the accent like a lit key */
  .slots,
  .banks,
  .pats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .slots span,
  .banks span,
  .pats span {
    padding-bottom: var(--s1);
    border-bottom: 2px solid var(--line);
  }
  .banks span {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 2ch;
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    color: var(--fg);
  }
  .banks small {
    font-size: var(--fs-2xs);
    font-weight: normal;
    color: var(--muted);
  }
  .pats {
    gap: var(--s1) var(--s3);
  }
  .slots .on,
  .banks .on,
  .pats .on {
    color: var(--led);
    border-color: var(--led);
  }
  .banks .on small {
    color: var(--led);
  }
  .trk {
    display: grid;
    gap: var(--s2);
    max-width: 30rem;
  }
  .trk .row {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    align-items: center;
  }
  .trk .t {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .trk .steps {
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    gap: 3px;
  }
  .trk i {
    height: 0.6rem;
    border-bottom: 2px solid var(--line);
  }
  .trk i.x {
    border-color: var(--fg);
    background: var(--fg);
    border-radius: 1px;
  }
</style>
