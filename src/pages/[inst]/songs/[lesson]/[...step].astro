---
import LessonPage from "../../../../components/LessonPage.astro";
import { INSTRUMENTS } from "../../../../course/index.js";

/* /model-cycles/songs/<lesson> is the intro; /model-cycles/songs/<lesson>/<n> is step n; one past the last step is the optional challenge */
export function getStaticPaths() {
  return INSTRUMENTS.filter((I) => I.ready).flatMap((I) =>
    I.lessons.filter((L) => !!L.song).flatMap((L) =>
      [...L.steps.keys(), ...(L.challenge ? [L.steps.length] : [])].map((i) => ({ params: { inst: I.slug, lesson: L.slug, step: i ? String(i) : undefined }, props: { I, L, act: i } }))));
}
const { I, L, act } = Astro.props;
---
<LessonPage I={I} L={L} act={act} />
