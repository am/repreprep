---
// Side-by-side test of the home logo's beat animations, to pick one. Not linked from the site.
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
const variants = [
  ["split", "", "H · No noise", "The one you picked: each beat one layer snaps to a new spot while a different layer pulses toward the background."],
  ["split", "static", "H + Static", "The bold bottom layer is always full of digital static, like a weak signal."],
  ["split", "lines", "H + Scanlines", "The middle layer is cut into thin horizontal lines that slowly roll, like an old screen."],
  ["split", "tear", "H + Tear", "The layer that moves on each beat is torn sideways in horizontal bands for a split second."],
  ["split", "fizz", "H + Fizz", "The layer that pulses breaks up into static for the length of the pulse, then comes back solid."],
] as const;
---
<Base title="Logo beats" noindex>
  <div class="page"><h2>Logo beats</h2><p class="goal">Digital noise on top of the beat. Tap a logo to set its tempo.</p></div>
  <div class="lab">
    {variants.map(([d, n, name, text]) => (
      <section>
        <div class="mark"><Logo dance={d} noise={n || undefined} /></div>
        <h3>{name}</h3>
        <p>{text}</p>
      </section>
    ))}
  </div>
</Base>
