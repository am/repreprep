---
// Side-by-side test of the home logo's beat animations, to pick one. Not linked from the site.
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
const variants = [
  ["snappulse", "F · Snappy drift + pulse", "As before: each beat one layer snaps to a new spot and pulses. On the bar another layer jolts and the colors swap."],
  ["split", "H · Move one, pulse another", "Each beat one layer snaps to a new spot while a different layer pulses. On the bar another layer jolts and the colors swap."],
  ["kick", "I · Steady pulse", "The thin top layer pulses on every beat like a kick drum, deeper on the bar where the colors swap. The other two layers take turns moving."],
] as const;
---
<Base title="Logo beats" noindex>
  <div class="page"><h2>Logo beats</h2><p class="goal">A few ways for the home logo to move at 90 BPM. Click a logo to remix its colors.</p></div>
  <div class="lab">
    {variants.map(([d, name, text]) => (
      <section>
        <div class="mark"><Logo dance={d} /></div>
        <h3>{name}</h3>
        <p>{text}</p>
      </section>
    ))}
  </div>
</Base>
