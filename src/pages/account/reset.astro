---
import Base from "../../layouts/Base.astro";
import { SIGN_IN } from "astro:env/client";
---

<Base noindex title="Choose a new password" description="Choose a new password for your Rep Rep Rep account.">
  <div class="page" id="reset">
    <h2>Choose a new password</h2>
    {SIGN_IN ? (
      <Fragment>
        <form class="reset" data-reset data-astro-reload hidden>
          <label>
            New password (at least 12 characters)
            <input
              type="password"
              name="password"
              required
              minlength="12"
              maxlength="128"
              autocomplete="new-password"
            />
          </label>
          <div class="strength" data-strength aria-live="polite">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <small data-strength-label></small>
          </div>
          <div class="row">
            <button class="btn primary" type="submit">
              Save and log in again
            </button>
          </div>
        </form>
        <p class="msg" data-reset-msg role="status" hidden></p>
      </Fragment>
    ) : (
      <p>Logging in isn't set up on this site yet.</p>
    )}
  </div>
</Base>

<script>
  import { strengthMeter } from "../../client/strength.js";
  /* The link in the email goes through Better Auth, which sends the browser here with ?token=… when the link is good,
     or ?error=INVALID_TOKEN when it's used up or too old. */
  const ERRORS = {
    INVALID_TOKEN: "This link has expired or was already used. Ask for a new one from the log-in page.",
    PASSWORD_COMPROMISED: "That password has turned up in a data breach, so it's easy to guess. Please choose another.",
    PASSWORD_TOO_SHORT: "Please use a password of at least 12 characters.",
    PASSWORD_TOO_LONG: "Please use a password of at most 128 characters.",
  };
  const AGAIN = ' <a href="/account">Back to log in</a>.';

  function setup() {
    const form = document.querySelector<HTMLFormElement>("[data-reset]");
    const msg = document.querySelector<HTMLElement>("[data-reset-msg]");
    if (!form || !msg) return;
    const say = (text: string, bad = false, link = false) => {
      msg.hidden = false;
      msg.className = bad ? "msg bad" : "msg";
      msg.textContent = text;
      if (link) msg.insertAdjacentHTML("beforeend", AGAIN);
    };
    const q = new URLSearchParams(location.search);
    const token = q.get("token");
    /* the token stays out of the address bar and the browser history */
    if (token) history.replaceState(null, "", location.pathname);
    if (!token) return say(ERRORS.INVALID_TOKEN, true, true);
    form.hidden = false;
    strengthMeter({
      input: form.password,
      meter: form.querySelector<HTMLElement>("[data-strength]"),
      button: form.querySelector<HTMLButtonElement>('[type="submit"]'),
    });
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = form.querySelector("button");
      button.disabled = true;
      say("One moment…");
      const r = await fetch("/api/auth/reset-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ newPassword: form.password.value, token }),
      }).catch(() => null);
      const j = await r?.json().catch(() => ({}));
      button.disabled = false;
      if (r?.ok) {
        form.hidden = true;
        return say(
          "Your password is changed, and you're logged out everywhere. Log in with your new password.",
          false,
          true
        );
      }
      if (ERRORS[j?.code]) return say(ERRORS[j.code], true, j.code === "INVALID_TOKEN");
      say("Something went wrong. Please try again.", true);
    });
  }
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .reset {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    max-width: 28rem;
  }
  .reset label {
    display: block;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .reset input {
    display: block;
    width: 100%;
    margin-top: var(--s2);
    padding: var(--s3);
    border-radius: var(--r-btn);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: var(--fs-sm);
  }
</style>
