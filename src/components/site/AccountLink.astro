---
// The account icon in the header, at the left end of the controls pill, before the What's new bell. Only shown
// while sign-in is on. site.js puts your name in its label once you're signed in and fills the icon in.
---

<a class="acct" href="/account" id="acct" title="Log in or sign up" aria-label="Log in or sign up">
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="8" cy="5.5" r="2.75" />
    <path d="M2.75 14a5.25 5.25 0 0 1 10.5 0z" />
  </svg>
</a>

<style>
  /* sized and colored like the bell next to it */
  .acct {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.625rem;
    height: 1.375rem;
    margin-left: var(--s1);
    border-radius: var(--r-pill);
    color: var(--bg);
  }
  .acct:hover {
    opacity: 0.7;
  }
  .acct svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* signed in: the figure is filled */
  .acct.in svg {
    fill: currentColor;
  }
  /* the bell follows the icon, so it needs no gap of its own at the pill's left end */
  .acct + :global(.news) {
    margin-left: 0;
  }
</style>
