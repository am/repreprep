---
// The header on every page. On the home page it keeps only the theme switch and the progress (or account)
// link, since the page itself is the logo and the instrument picker. On phones everything but the logo folds
// into a menu opened by a knob; on wider screens the menu is just the rest of the header.
import Logo from "./Logo.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { INSTRUMENTS } from "../../course/index.js";
import { SIGN_IN } from "../../lib/features.js";
interface Props { inst?: any; home?: boolean }
const { inst, home } = Astro.props;
const acct = SIGN_IN ? "Sign in" : "Progress";
---
{home ? (
  <header class="top bare"><ThemeSwitch /><a class="acct" href="/account" id="acct">{acct}</a></header>
) : (
  <header class="top">
    <div class="brand"><h1><Logo /></h1></div>
    <button class="knob" type="button" aria-expanded="false" aria-controls="hmenu" aria-label="Menu" data-menu><svg viewBox="0 0 44 44" aria-hidden="true"><g transform="rotate(45 22 22)"><circle class="kn-cap" cx="22" cy="22" r="13.6"/><line class="kn-mark" x1="22" y1="22" x2="22" y2="8.4"/></g></svg></button>
    <div class="hmenu" id="hmenu">
      <nav class="instr" aria-label="Instrument">
        {INSTRUMENTS.map((x) => x.ready
          ? <a href={`/${x.slug}`} aria-current={x === inst ? "page" : undefined}>{x.name}</a>
          : <span class="off">{x.name}<small>next</small></span>)}
      </nav>
      <hr class="hsep" />
      {/* one pill: the step count (a link to the progress page: back up, load, reset) with the theme switch nested in it */}
      <div class="ctrls">
        {inst?.ready && <a class="meter" href="/account" title="Your progress: back up, load or reset" id="meterTxt">0 of 0 reps</a>}
        <ThemeSwitch />
      </div>
      {(SIGN_IN || !inst?.ready) && <a class="acct" href="/account" id="acct">{acct}</a>}
    </div>
  </header>
)}
