---
// The account pages, one per tab: Log in (/account), Sign up (/account/signup) and Your data (/account/data).
// Signed in, there are no tabs: /account and /account/data are one page, Your account, with your progress, your
// account's data and Log out. Who you are is only known in the browser, so the page holds both versions and its
// script shows the right one. With sign-in off, every one of them is just your progress.
import Base from "../../layouts/Base.astro";
import SectionTabs from "./SectionTabs.astro";
import AccountSignIn from "./AccountSignIn.astro";
import AccountData from "./AccountData.astro";
import { SIGN_IN } from "astro:env/client";
interface Props {
  view: "login" | "signup" | "data";
}
const { view } = Astro.props;
const form = SIGN_IN && view !== "data";
/* your progress and your account: the whole page on Your data (and with sign-in off), and on Log in once
   you're logged in */
const data = !SIGN_IN || view !== "signup";
const TITLE = {
  login: ["Log in", "Log in to keep your progress on every device."],
  signup: ["Sign up", "Make an account to keep your progress on every device."],
  data: ["Your data", "Back up, load or delete your progress."],
};
const [title, description] = SIGN_IN ? TITLE[view] : ["Your progress", "Back up your progress or load a saved copy."];
const TABS = [
  { key: "login", label: "Log in", href: "/account" },
  { key: "signup", label: "Sign up", href: "/account/signup" },
  { key: "data", label: "Your data", href: "/account/data" },
];
---

<Base noindex title={title} description={description}>
  <div class="page" id="account" data-view={view}>
    {SIGN_IN && <SectionTabs items={TABS} tab={view} label="Account" show="out" />}
    {form && <AccountSignIn view={view} />}

    {data && <AccountData title={title} form={form} />}
  </div>
</Base>

<script>
  import "../../client/account.js";
</script>
