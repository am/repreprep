---
// The Rep Rep Rep mark: three REPs (Manrope ExtraBold, Regular, ExtraLight) stacked on top of each other.
// Every page view and every click picks a new hand-picked set of three electric colors (far from the colors
// showing before, each clearly apart from the others and from the page background) and new offsets. Every 10 to 40 seconds it glitches: a short
// burst of blinks, slices and jumps that lands on a new remix. ExtraLight is always on top, Regular in the middle.
// With `dance` set (the home page), it moves on a 90 BPM grid instead: on each beat one layer snaps to a new spot
// while another pulses toward the background, the off-beats get a tiny random accent, and the first beat of each bar
// tears a layer and brings a new palette; all three layers also float very slowly.
// Hovering shows a TAP key; tapping the logo sets the tempo, like TAP TEMPO on the Model:Cycles, with a quiet click.
// the script is written into the page, not bundled, so the logo has its colors before the first paint
import logoScript from "../../client/logo.js?raw";
interface Props {
  dance?: boolean;
  bpm?: number;
}
const { dance, bpm = 90 } = Astro.props;
const layers = [
  // starting look, from the original sketch (used until the script runs, and without JS)
  { w: 800, c: "ink", x: 0.045, y: 0.03 },
  { w: 400, c: "blue", x: 0.09, y: 0.09 },
  { w: 200, c: "yellow", x: 0, y: 0 },
];
---

{dance ? (
  /* a dancing logo is also a tap-tempo key: hovering shows the key, tapping sets the beat */
  <span class="logo-wrap">
    <a href="/" class="logo" aria-label="Rep Rep Rep. Tap to set the tempo" data-dance data-bpm={bpm}>
      {layers.map((l) => (
        <span aria-hidden="true" style={`--w:${l.w};--c:var(--logo-${l.c});--x:${l.x}em;--y:${l.y}em`}>
          REP
        </span>
      ))}
    </a>
    <span class="tap" aria-hidden="true">
      <i></i>
      <b>TAP</b>
    </span>
    {/* horizontal bands of noise that push a layer sideways: a digital tear */}
    <svg class="defs" width="0" height="0" aria-hidden="true">
      <filter id="rrr-tear" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.0001 0.09" numOctaves="1" seed="2" />
        <feDisplacementMap in="SourceGraphic" scale="34" xChannelSelector="R" yChannelSelector="B" />
      </filter>
    </svg>
  </span>
) : (
  <a href="/" class="logo" aria-label="Rep Rep Rep, home">
    {layers.map((l) => (
      <span aria-hidden="true" style={`--w:${l.w};--c:var(--logo-${l.c});--x:${l.x}em;--y:${l.y}em`}>
        REP
      </span>
    ))}
  </a>
)}
<script is:inline data-astro-rerun set:html={logoScript} />
<style>
  /* logo: three REPs in one grid cell, colors and offsets set per layer by Logo.astro */
  :global(:root) {
    --logo-blue: #1434f5;
    --logo-yellow: #fce64e;
    --logo-ink: var(--fg);
  } /* first paint only */
  .logo {
    display: inline-grid;
    padding: 0 0.1em 0.1em 0;
    font-family: var(--display);
    text-decoration: none;
    letter-spacing: var(--ls-tight);
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .logo span {
    grid-area: 1/1;
    font-weight: var(--w);
    color: var(--c);
    transform: translate(var(--x), var(--y));
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }
  .logo span:nth-child(1) {
    z-index: 1;
  }
  .logo span:nth-child(2) {
    z-index: 2;
  }
  .logo span:nth-child(3) {
    z-index: 3;
  }
  .logo.glitch span {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo span {
      transition: none;
    }
  }
  /* dancing logos: quick snaps */
  .logo[data-dance] span {
    transition: transform 0.14s cubic-bezier(0.2, 0.9, 0.3, 1);
    animation: float var(--fd) ease-in-out var(--fdl) infinite;
  }
  /* a slow float on top of the beat moves (it uses `translate`, the beat uses `transform`), each layer on its own clock */
  .logo[data-dance] span:nth-child(1) {
    --fd: 9.3s;
    --fdl: -2s;
  }
  .logo[data-dance] span:nth-child(2) {
    --fd: 11.7s;
    --fdl: -7s;
  }
  .logo[data-dance] span:nth-child(3) {
    --fd: 7.9s;
    --fdl: -4s;
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    25% {
      translate: 0.018em -0.014em;
    }
    50% {
      translate: -0.012em 0.02em;
    }
    75% {
      translate: -0.02em -0.008em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo[data-dance] span {
      animation: none;
    }
  }
  /* the tap-tempo key next to a dancing logo: shown on hover/focus (always on touch screens), its light flashes
     on every beat and brighter on the bar; while tapping it reads out the tempo */
  .logo-wrap {
    position: relative;
    display: inline-block;
  }
  .tap {
    position: absolute;
    right: -0.1em;
    bottom: -0.2em;
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--s3) var(--s2) var(--s2);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: var(--r-s);
    background: var(--surface);
    font: 600 0.75rem/1 var(--mono);
    letter-spacing: var(--ls-caps);
    color: var(--fg);
    opacity: 0;
    transform: translateY(0.25rem);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    pointer-events: none;
    white-space: nowrap;
  }
  .tap i {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--dev-led-off);
    transition:
      background 0.12s ease,
      box-shadow 0.12s ease;
  }
  .tap.lit i {
    background: var(--led);
    box-shadow: 0 0 0.5rem var(--led);
  }
  .tap.lit:not(.down) i {
    opacity: 0.6;
  }
  .logo-wrap:hover .tap,
  .logo-wrap:focus-within .tap,
  .tap.on {
    opacity: 1;
    transform: none;
  }
  .logo-wrap:hover .logo {
    cursor: pointer;
  }
  @media (hover: none) {
    .tap {
      opacity: 0.85;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tap {
      display: none;
    }
  }
  .logo-wrap .defs {
    position: absolute;
    width: 0;
    height: 0;
  }
</style>
