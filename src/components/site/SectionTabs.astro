---
// The tabs under the header: an instrument's sections, or the account pages (items). An item with `show`
// ("in" or "out") is only shown signed in or signed out; the account page's script does that.
interface Item {
  key: string;
  label: string;
  href: string;
  show?: "in" | "out";
}
interface Props {
  inst?: any;
  tab?: string;
  items?: Item[];
  label?: string;
}
const { inst, tab, items, label = "Sections" } = Astro.props;
const TABS: Item[] = items || [
  { key: "lessons", label: "Lessons", href: `/${inst.slug}` },
  { key: "panel", label: "Panel guide", href: `/${inst.slug}/panel` },
  { key: "saving", label: "Saving", href: `/${inst.slug}/saving` },
  { key: "machines", label: "Machines", href: `/${inst.slug}/machines` },
  { key: "shortcuts", label: "Shortcuts", href: `/${inst.slug}/shortcuts` },
];
/* "Log in" and "Your account" are the same page, signed out or in */
const current = (k: string) => tab === k || (tab === "login" && k === "account");
---

<nav class="tabs" aria-label={label}>
  {TABS.map((t) => (
    <a href={t.href} aria-current={current(t.key) ? "page" : undefined} data-show={t.show} hidden={!!t.show}>
      {t.label}
    </a>
  ))}
</nav>

<style>
  .tabs {
    display: flex;
    gap: var(--s1);
    margin: var(--s4) 0 var(--s6);
    flex-wrap: wrap;
  }
  .tabs a {
    text-decoration: none;
    display: inline-block;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: var(--s2) var(--s3);
    font-family: var(--display);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-key);
    text-transform: uppercase;
    font-size: var(--fs-s);
    color: var(--muted);
    cursor: pointer;
  }
  .tabs a[hidden] {
    display: none;
  }
  .tabs a[aria-current="page"] {
    color: var(--fg);
    border-color: var(--led);
  }
  @media (max-width: 836px) {
    .tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin: var(--s3) calc(-1 * var(--s5)) var(--s5);
      padding-inline: var(--s5);
    }
    .tabs::-webkit-scrollbar {
      display: none;
    }
    .tabs a {
      white-space: nowrap;
      padding-inline: var(--s2);
    }
  }
</style>
