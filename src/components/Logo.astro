---
// The Rep Rep Rep mark: three REPs (Manrope ExtraBold, Regular, ExtraLight) stacked on top of each other.
// Every page view and every click picks a new hand-picked set of three electric colors (far from the colors
// showing before, each clearly apart from the others and from the page background) and new offsets. Every 10 to 40 seconds it glitches: a short
// burst of blinks, slices and jumps that lands on a new remix. ExtraLight is always on top, Regular in the middle.
// With `dance` set (the home page), it moves on a 90 BPM grid instead: one layer at a time does something small
// on each beat, and the first beat of each bar brings a color change. The variants are compared on /lab/logo.
interface Props { dance?: "snappulse" | "split" | "kick"; bpm?: number }
const { dance, bpm = 90 } = Astro.props;
const layers = [
  // starting look, from the original sketch (used until the script runs, and without JS)
  { w: 800, c: "ink", x: 0.045, y: 0.03 },
  { w: 400, c: "blue", x: 0.09, y: 0.09 },
  { w: 200, c: "yellow", x: 0, y: 0 },
];
---
<a href="/" class="logo" aria-label="Rep Rep Rep, home" data-dance={dance} data-bpm={dance ? bpm : undefined}>
  {layers.map((l) => (
    <span aria-hidden="true" style={`--w:${l.w};--c:var(--logo-${l.c});--x:${l.x}em;--y:${l.y}em`}>REP</span>
  ))}
</a>
<script is:inline data-astro-rerun>
  (function () {
    function shuffle(a) {
      for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)), t = a[i]; a[i] = a[j]; a[j] = t; }
      return a;
    }
    // hand-picked sets of three colors, each set clearly apart within itself (checked in OKLab) and readable
    // on the page background; light mode gets its own deeper sets
    var PALETTES = {
      dark: [["#2f5bff","#ffe14d","#ff3b6b"],["#00e0b8","#8a3cff","#ff8a00"],["#ff2bd6","#00c2ff","#c6ff00"],["#ff4f1f","#4d7cff","#7dffb0"],
        ["#8b5cff","#ffb000","#00d68f"],["#ff006e","#3a86ff","#ffbe0b"],["#00f5d4","#f15bb5","#6a4dff"],["#fb5607","#9b5cff","#06d6a0"],
        ["#c1ff00","#ff00a0","#1f6bff"],["#ff7a00","#00b3ff","#d000ff"],["#1aff6e","#ff2e2e","#7b61ff"],["#fff03a","#ff3df0","#00a3ff"]],
      light: [["#1434f5","#ff7a00","#00a37a"],["#008f7a","#7a2cff","#ff4f1f"],["#d4009b","#0072e0","#3fae00"],["#e01e00","#2f2fd0","#00a37a"],
        ["#6d28d9","#e07b00","#009e60"],["#e0005a","#1c5fe0","#c79400"],["#0096a8","#c2007a","#4b2bff"],["#e04800","#7b2fe0","#00956b"],
        ["#5aa800","#d6008a","#0047d6"],["#d96600","#0089d6","#a600d6"],["#00a344","#d61f1f","#5a3dff"],["#b8a000","#d600c2","#0070d6"]],
    };
    function lin(x) { return x <= 0.04045 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); }
    function lum(c) {
      var v = c.map(lin);
      return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
    }
    function oklab(h) {
      var c = [1, 3, 5].map(function (i) { return lin(parseInt(h.slice(i, i + 2), 16) / 255); });
      var l = Math.cbrt(0.4122214708 * c[0] + 0.5363325363 * c[1] + 0.0514459929 * c[2]);
      var m = Math.cbrt(0.2119034982 * c[0] + 0.6806995451 * c[1] + 0.1073969566 * c[2]);
      var s = Math.cbrt(0.0883024619 * c[0] + 0.2817188376 * c[1] + 0.6299787005 * c[2]);
      return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];
    }
    function dist(a, b) { var A = oklab(a), B = oklab(b); return Math.hypot(A[0] - B[0], A[1] - B[1], A[2] - B[2]); }
    function bgLum() {
      var m = getComputedStyle(document.body).backgroundColor.match(/[\d.]+/g);
      return m ? lum(m.slice(0, 3).map(function (x) { return x / 255; })) : 0;
    }
    // the next set of colors: one whose every color is as far as possible from every color showing now,
    // so a swap reads as a new palette, not the same three colors trading places
    function palette(el) {
      var list = PALETTES[bgLum() > 0.4 ? "light" : "dark"], cur = [];
      if (el) cur = [0, 1, 2].map(function (i) { return el.children[i].style.getPropertyValue("--c"); }).filter(function (c) { return c.charAt(0) === "#"; });
      if (!cur.length) try { cur = (sessionStorage.getItem("rrr-logo-pal") || "").split(",").filter(Boolean); } catch (e) {}
      var recent = [];
      try { recent = JSON.parse(sessionStorage.getItem("rrr-logo-recent") || "[]"); } catch (e) {}
      var ranked = list.filter(function (p) { return recent.indexOf(p.join()) < 0; }).map(function (p) {
        var gap = Infinity;
        p.forEach(function (a) { cur.forEach(function (b) { gap = Math.min(gap, dist(a, b)); }); });
        return { p: p, gap: cur.length ? gap : Math.random() };
      }).sort(function (a, b) { return b.gap - a.gap; });
      var p = ranked[0].p; // the farthest from what's showing
      recent = [p.join()].concat(recent).slice(0, 5); // the last five sets sit out, so it doesn't bounce between two
      try { sessionStorage.setItem("rrr-logo-pal", p.join(",")); sessionStorage.setItem("rrr-logo-recent", JSON.stringify(recent)); } catch (e) {}
      return p.slice();
    }
    // each layer gets its own offset slot (plus a little jitter) so all three always show,
    // and the slots stay within a small box so the word still reads as one REP
    function slots() {
      return shuffle([0, 0.045, 0.09]).map(function (v) { return (v + Math.random() * 0.02).toFixed(3) + "em"; });
    }
    function remix(el) {
      var c = shuffle(palette(el)), x = slots(), y = slots();
      Array.prototype.forEach.call(el.children, function (s, i) {
        s.style.setProperty("--c", c[i]);
        s.style.setProperty("--x", x[i]);
        s.style.setProperty("--y", y[i]);
      });
    }
    function rand(a, b) { return a + Math.random() * (b - a); }
    // one glitch: a few fast frames of hidden layers, cut slices and jumps, then a fresh remix
    function glitch(el) {
      var frames = 3 + Math.floor(Math.random() * 4), c = palette(el);
      el.classList.add("glitch");
      (function frame(n) {
        if (!n) {
          Array.prototype.forEach.call(el.children, function (s) { s.style.opacity = ""; s.style.clipPath = ""; });
          remix(el);
          el.classList.remove("glitch");
          return;
        }
        Array.prototype.forEach.call(el.children, function (s, i) {
          s.style.opacity = Math.random() < 0.25 ? "0" : "";
          var top = rand(0, 70);
          s.style.clipPath = Math.random() < 0.5 ? "inset(" + top.toFixed(0) + "% 0 " + (100 - top - rand(15, 40)).toFixed(0) + "% 0)" : "";
          s.style.setProperty("--x", rand(-0.12, 0.2).toFixed(3) + "em");
          s.style.setProperty("--y", rand(-0.06, 0.12).toFixed(3) + "em");
          if (Math.random() < 0.5) s.style.setProperty("--c", c[(i + n) % 3]);
        });
        setTimeout(function () { frame(n - 1); }, rand(40, 110));
      })(frames);
    }
    // beats are scheduled from a fixed start time so they never drift
    function beats(el, bpm, onBeat) {
      var ms = 60000 / bpm, t0 = performance.now(), n = 0;
      (function tick() {
        if (!el.isConnected) return; // page swapped; the new page starts its own loop
        if (!document.hidden) onBeat(n % 4 === 0, ms);
        n++;
        if (performance.now() - (t0 + n * ms) > ms) t0 = performance.now() - n * ms; // back from a background tab
        setTimeout(tick, Math.max(0, t0 + n * ms - performance.now()));
      })();
    }
    function later(ms, f) { setTimeout(f, ms); }
    function slot() { return rand(0, 0.11).toFixed(3) + "em"; }
    // a whole new set of colors at once (offsets stay)
    function recolor(el) {
      var c = shuffle(palette(el));
      [0, 1, 2].forEach(function (i) { el.children[i].style.setProperty("--c", c[i]); });
    }
    // one layer per beat, never the same one twice in a row (and never `not`, when given)
    function pick(el, not) {
      var i;
      do { i = Math.floor(Math.random() * 3); } while (i === el._last || el.children[i] === not);
      el._last = i;
      return el.children[i];
    }
    // a short, soft dip to about half opacity
    function pulse(s, depth) {
      s.animate([{ opacity: 1 }, { opacity: depth || 0.5, offset: 0.3 }, { opacity: 1 }], { duration: 220, easing: "ease-out" });
    }
    // a layer moves to a new spot (glide speed set in CSS per dance); on the bar another layer jolts and the colors swap
    function drift(el, down, s) {
      s = s || pick(el);
      s.style.setProperty("--x", slot());
      s.style.setProperty("--y", slot());
      if (down) {
        var o = pick(el), x = o.style.getPropertyValue("--x");
        o.style.transition = "none";
        o.style.setProperty("--x", (parseFloat(x) + 0.08).toFixed(3) + "em");
        later(60, function () { o.style.setProperty("--x", x); o.style.transition = ""; });
        recolor(el);
      }
      return s;
    }
    var DANCES = {
      // a layer snaps to a new spot and that same layer pulses
      snappulse: function (el, down) { pulse(drift(el, down)); },
      // one layer snaps to a new spot while a different layer pulses
      split: function (el, down) {
        var p = pick(el);
        drift(el, down, pick(el, p));
        pulse(p);
      },
      // the ExtraLight layer (on top) pulses on every beat like a kick; the other two take turns moving
      kick: function (el, down) {
        var top = el.children[2], s = el.children[el._mover = el._mover === 0 ? 1 : 0];
        drift(el, false, s);
        pulse(top, down ? 0.3 : 0.55);
        if (down) recolor(el);
      },
    };
    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    Array.prototype.forEach.call(document.querySelectorAll(".logo:not([data-on])"), function (el) {
      el.dataset.on = "1";
      remix(el);
      var d = DANCES[el.dataset.dance];
      if (d && !reduce) beats(el, +el.dataset.bpm, function (down) { d(el, down); });
      else if (!reduce) {
        (function next() {
          setTimeout(function () {
            if (!el.isConnected) return;
            if (!document.hidden) glitch(el);
            next();
          }, rand(10000, 40000));
        })();
      }
      el.addEventListener("click", function (e) {
        remix(el);
        if (location.pathname === "/" || d) e.preventDefault();
      });
    });
  })();
</script>
