---
// The step player: the drawing or the panel on the left (on the intro, the lesson's title in big type), the step on the right. The optional challenge is
// one more step after the last one: same player, its own kind, and Finish moves there.
import LessonMenu from "./LessonMenu.astro";
import IntroCard from "./IntroCard.astro";
import StepText from "./StepText.astro";
import Quiz from "./Quiz.astro";
import HearNote from "./HearNote.astro";
import Keys from "./Keys.astro";
import Figure from "./Figure.astro";
import PanelDrawing from "./PanelDrawing.astro";
import { KIND, keyCap } from "../../course/shared/text.js";
import { lessonLabel, stepPath, nextLesson } from "../../course/index.js";
interface Props {
  I: any;
  L: any;
  act: number;
}
const { I, L, act } = Astro.props;
const n = L.steps.length,
  total = n + (L.challenge ? 1 : 0);
const ch = act === n;
const st = ch ? { k: "challenge" } : L.steps[act];
const k = st.k || "play";
const end = act === total - 1;
const nx = nextLesson(I, L);
const nextHref = end ? (nx ? nx.path : L.path) : stepPath(L, act + 1);
const legend = keyCap("PRESS", "press") + keyCap("HOLD", "hold") + keyCap("TURN", "turn");
---

<section
  class="player"
  id="player"
  aria-label="Step player"
  data-inst={I.key}
  data-lesson={L.id}
  data-step={act}
  data-steps={n}
  data-next={nx?.id}
  data-next-path={nx?.path}
>
  <div class="phead">
    <details class="picker">
      <summary class="ttl" title="Jump to another lesson">
        {lessonLabel(L)} · {L.title}
        <span class="caret" aria-hidden="true"></span>
      </summary>
      <LessonMenu I={I} L={L} />
    </details>
    <div class="dots" style={`--p:${total > 1 ? act / (total - 1) : 0}`}>
      {L.steps.map((s: any, i: number) => {
        const lab = KIND[s.k || "play"];
        return (
          <a
            href={stepPath(L, i)}
            data-step={i}
            aria-current={String(i === act)}
            aria-label={`${lab}, step ${i + 1}`}
            title={lab}
          ></a>
        );
      })}
      {L.challenge && (
        <a
          class="opt"
          href={stepPath(L, n)}
          data-step={n}
          aria-current={String(ch)}
          aria-label="Challenge (optional)"
          title="Challenge (optional)"
        ></a>
      )}
    </div>
    <button class="maxbtn" type="button" data-max aria-label="Maximize" title="Maximize">
      <svg class="mx-in" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" />
      </svg>
      <svg class="mx-out" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6 2v4H2M14 6h-4V2M10 14v-4h4M2 10h4v4" />
      </svg>
    </button>
  </div>
  <div class="pbody" id="pbody">
    <div class={st.intro ? "pstage intro" : "pstage"}>
      {st.intro ? (
        <IntroCard L={L} part="hero" />
      ) : st.fig ? (
        <div class="figwrap">
          <Figure I={I} fig={st.fig} id={`${L.id}:${act}`} />
        </div>
      ) : (
        <PanelDrawing I={I} hl={st.hl} />
      )}
    </div>
    <div
      class="gutter"
      id="gutter"
      role="separator"
      aria-orientation="vertical"
      aria-label="Resize the step panel"
      tabindex="0"
      title="Drag to resize · double-click to reset"
    ></div>
    <div class="pstep" id="now">
      <div class="h">
        <span class={`kind k-${k}`}>{KIND[k]}</span>
        {ch && " · optional"}
      </div>
      {ch ? (
        <Fragment>
          <div class="ptxt">
            <p>
              <Keys I={I} text={L.challenge} />
            </p>
          </div>
          <p class="t-note">Optional. Try it now, or come back to it any time.</p>
        </Fragment>
      ) : (
        <Fragment>
          {st.intro ? (
            <IntroCard L={L} part="details" />
          ) : (
            <div class="ptxt">
              <StepText I={I} st={st} />
            </div>
          )}
          {st.q && <Quiz I={I} st={st} />}
          {st.hear && <HearNote I={I} st={st} />}
        </Fragment>
      )}
      <div class="ctl" id="ctlinfo" hidden></div>
      <div class="grow"></div>
      <div class="pfoot">
        <div class="legend" hidden={k !== "play"}>
          <Fragment set:html={legend} />
          <button
            type="button"
            class="hint"
            aria-label="Tips: click a control to learn it. Left and right arrow keys move between steps."
          >
            i
            <span class="tip" aria-hidden="true">
              Click a control to learn it. The ← → keys move between steps.
            </span>
          </button>
        </div>
        <div class="navrow">
          {act === 0 ? (
            <button class="btn" disabled aria-label="Previous step">
              Back
            </button>
          ) : (
            <a class="btn" href={stepPath(L, act - 1)} data-nav="-1" aria-label="Previous step">
              Back
            </a>
          )}
          <a class="btn primary" href={nextHref} data-nav="1" data-end={end ? "" : undefined}>
            {end ? "Finish" : act === 0 ? "Start" : "Next"}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* Marks where you are, saves ticks as you move on, and runs the player's controls: the step panel's
     width, the full-window switch, the lesson picker, arrow keys, and clicking a control on the panel. */
  import { onProgress, persist, refresh, ist, state } from "../../client/progress.js";
  import { player, curLesson, markAllDone, goNextLesson } from "../../client/lesson.js";
  import { CYCLES_CONTROLS, iconSvg } from "../../course/model-cycles/controls.js";
  import { keyify } from "../../course/shared/text.js";
  import { esc } from "../../course/shared/html.js";

  const PANELS = { cycles: { controls: CYCLES_CONTROLS, icon: iconSvg } };
  const $ = (s) => document.querySelector(s);

  /* the player fills the window below the header */
  function fitPlayer() {
    const el = player();
    if (!el) return;
    const top = el.getBoundingClientRect().top + window.scrollY;
    el.style.setProperty("--ph", `calc(100dvh - ${Math.round(top) + 20}px)`);
  }
  window.addEventListener("resize", fitPlayer);

  onProgress(() => {
    const c = curLesson();
    if (!c) return;
    const s = ist(c.k);
    if (s.lesson !== c.id || (s.active[c.id] ?? 0) !== c.act) {
      s.lesson = c.id;
      s.active[c.id] = c.act;
      persist();
    }
    document
      .querySelectorAll(".dots [data-step]")
      .forEach((a) => a.classList.toggle("done", !!s.steps[c.id + ":" + a.dataset.step]));
    const mx = $("[data-max]");
    if (mx) {
      const l = state.focus ? "Exit full window (Esc)" : "Maximize";
      mx.setAttribute("aria-label", l);
      mx.title = l;
    }
    document.documentElement.classList.toggle("focus", !!state.focus);
    if (state.stepW) document.documentElement.style.setProperty("--sw", state.stepW + "px");
    fitPlayer();
  });
  function setFocus(on) {
    state.focus = on;
    persist();
    refresh();
  }

  /* drag the gutter to resize the step column; the width is saved with your progress */
  function clampStepW(w) {
    const b = $("#pbody");
    const max = b ? Math.max(320, b.clientWidth * 0.7) : 900;
    return Math.round(Math.min(Math.max(w, 260), max));
  }
  function setStepW(w, save) {
    state.stepW = clampStepW(w);
    document.documentElement.style.setProperty("--sw", state.stepW + "px");
    if (save) persist();
  }
  document.addEventListener("pointerdown", (e) => {
    const g = e.target.closest("#gutter");
    if (!g) return;
    e.preventDefault();
    g.setPointerCapture(e.pointerId);
    g.classList.add("drag");
    document.body.classList.add("resizing");
    const right = $("#pbody").getBoundingClientRect().right;
    const move = (ev) => setStepW(right - ev.clientX, false);
    const up = () => {
      g.removeEventListener("pointermove", move);
      g.classList.remove("drag");
      document.body.classList.remove("resizing");
      persist();
    };
    g.addEventListener("pointermove", move);
    g.addEventListener("pointerup", up, { once: true });
    g.addEventListener("pointercancel", up, { once: true });
  });
  document.addEventListener("dblclick", (e) => {
    if (e.target.closest("#gutter")) {
      delete state.stepW;
      document.documentElement.style.removeProperty("--sw");
      persist();
    }
  });

  /* lesson picker: close when clicking elsewhere or pressing Esc */
  document.addEventListener(
    "click",
    (e) => {
      document.querySelectorAll("details.picker[open]").forEach((d) => {
        if (!d.contains(e.target)) d.open = false;
      });
    },
    true
  );
  document.addEventListener(
    "keydown",
    (e) => {
      if (e.key === "Escape") {
        const d = $("details.picker[open]");
        if (d) {
          d.open = false;
          e.stopImmediatePropagation();
        }
      }
    },
    true
  );

  document.addEventListener(
    "click",
    (e) => {
      if (e.target.closest("[data-closectl]")) {
        $("#ctlinfo").hidden = true;
        return;
      }
      if (e.target.closest("[data-max]")) {
        setFocus(!state.focus);
        return;
      }
      /* a control on the panel: what it does, in a box over the step */
      const ctl = e.target.closest("svg .c");
      if (ctl) {
        if (ctl.closest("[data-panel-guide]")) return;
        const I = PANELS[document.body.dataset.inst],
          c = I && I.controls[ctl.dataset.id],
          box = $("#ctlinfo");
        if (c && box) {
          box.hidden = false;
          box.innerHTML = `<div class="h">${esc(c.kind)} <button class="x" data-closectl aria-label="Close">×</button></div><b>${esc(c.name)}</b>${c.sub ? ` <span class="sec">(${esc(c.sub)})</span>` : ""}. ${keyify(I, c.desc, "")}`;
        }
        return;
      }
      /* Next ticks the step you're on; Finish on the last step moves to the next lesson */
      const nav = e.target.closest("[data-nav]");
      const c = nav && nav.dataset.nav === "1" && curLesson();
      if (!c) return;
      const s = ist(c.k);
      if (c.act < c.n) {
        s.steps[c.id + ":" + c.act] = true;
        markAllDone(s, c);
      } /* the optional challenge is never a rep */
      if (nav.hasAttribute("data-end")) {
        e.preventDefault();
        goNextLesson(s, c);
        return;
      }
      persist(); /* the link opens the next step */
    },
    true
  ); /* capture: runs before the router follows a link, so Finish can pick where to go */

  document.addEventListener("keydown", (e) => {
    if (e.target.id === "gutter" && (e.key === "ArrowLeft" || e.key === "ArrowRight")) {
      e.preventDefault();
      const cur = $(".pstep").getBoundingClientRect().width;
      setStepW(cur + (e.key === "ArrowLeft" ? 40 : -40), true);
      return;
    }
    if (player() && !e.target.closest("textarea,input,select") && !e.metaKey && !e.ctrlKey && !e.altKey) {
      if (e.key === "Escape" && state.focus) {
        setFocus(false);
        return;
      }
      const nav = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (nav) {
        const b = $(`[data-nav="${nav}"]`);
        if (b) {
          e.preventDefault();
          b.click();
        }
      }
    }
  });
</script>

<style>
  /* step player */
  /* open on the page, no box: the drawing and the step sit straight on the background */
  .player {
    --ph: calc(100dvh - 2rem);
    height: max(32.5rem, var(--ph));
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    scroll-margin-top: var(--s3);
  }
  .phead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s4);
  }
  .phead .ttl {
    font-family: var(--display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-lg);
    min-width: 0;
  }
  .phead .ttl span {
    color: var(--muted);
    font-weight: var(--fw-medium);
  }
  .picker {
    position: relative;
    min-width: 0;
  }
  .picker summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: var(--s1) var(--s3) var(--s1) 0;
    border-radius: var(--r-m);
  }
  .picker summary::-webkit-details-marker {
    display: none;
  }
  .picker summary:hover {
    color: var(--led);
  }
  .picker .caret {
    width: 0.4375rem;
    height: 0.4375rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    opacity: 0.6;
  }
  .picker[open] .caret {
    transform: rotate(-135deg) translateY(-2px);
  }
  .dots {
    flex: 1 1 13.75rem;
    min-width: 10rem;
    max-width: 32.5rem;
    margin-left: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    height: 1.5rem;
  }
  .dots::before {
    content: "";
    position: absolute;
    left: 0.6875rem;
    right: 0.6875rem;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--line);
    border-radius: var(--r-xs);
  }
  .dots::after {
    content: "";
    position: absolute;
    left: 0.6875rem;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    width: calc((100% - 1.375rem) * var(--p, 0));
    background: var(--done);
    border-radius: var(--r-xs);
  }
  .dots a {
    position: relative;
    z-index: 1;
    width: 1.375rem;
    height: 1.375rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dots a::before {
    content: "";
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--surface-2);
    border: 2px solid var(--line);
    box-sizing: border-box;
    transition: transform 0.12s;
  }
  .dots a:hover::before {
    transform: scale(1.3);
  }
  .dots a.done::before {
    background: var(--done);
    border-color: var(--done);
  }
  .dots a.opt::before {
    border-style: dashed;
    border-color: var(--hold);
  }
  .dots a[aria-current="true"]::before {
    width: 0.875rem;
    height: 0.875rem;
    background: var(--surface);
    border: 0.1875rem solid var(--led);
  }
  /* icon only: expand arrows, or collapse arrows while the player fills the window */
  .maxbtn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--line);
    background: none;
    border-radius: var(--r-m);
    cursor: pointer;
    color: var(--muted);
  }
  /* on phones: lesson title and maximize share the first row, the step timeline gets its own full-width row below */
  @media (max-width: 836px) {
    .phead .picker {
      flex: 1;
    }
    .phead .maxbtn {
      order: 1;
    }
    .phead .dots {
      order: 2;
      flex-basis: 100%;
      max-width: none;
      margin-left: 0;
    }
  }
  .maxbtn svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .maxbtn .mx-out,
  :global(html.focus) .maxbtn .mx-in {
    display: none;
  }
  :global(html.focus) .maxbtn .mx-out {
    display: block;
  }
  .maxbtn:hover {
    color: var(--fg);
    border-color: var(--faint);
  }
  .pbody {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0.875rem var(--sw, clamp(18.75rem, 30%, 28.75rem));
    gap: var(--s1);
  }
  .gutter {
    cursor: col-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-s);
    touch-action: none;
  }
  .gutter::before {
    content: "";
    width: 0.25rem;
    height: 2.75rem;
    border-radius: var(--r-xs);
    background: var(--line);
    transition:
      background 0.15s,
      height 0.15s;
  }
  .gutter:hover::before,
  .gutter:focus-visible::before,
  .gutter.drag::before {
    background: var(--led);
    height: 4.5rem;
  }
  .pstage {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pstage > :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .pstage.intro {
    justify-content: flex-start;
  }
  /* the step keeps its card: it separates the text from the drawing */
  .pstep {
    min-height: 0;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    padding: var(--s5) var(--s5);
    border-radius: var(--r-l);
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .pstep :global(.h) {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-caps);
    color: var(--faint);
    text-transform: uppercase;
  }
  /* on phones the step drops its card outline and padding, so the text runs the full width of the page */
  @media (max-width: 836px) {
    .pstep {
      border: 0;
      border-radius: 0;
      padding-inline: 0;
    }
  }
  .pstep :global(.ptxt) {
    font-size: var(--fs-step);
    line-height: var(--lh-loose);
    margin: 0;
  }
  .ptxt :global(p) {
    margin: 0 0 0.6em;
  }
  .ptxt :global(p:last-child) {
    margin-bottom: 0;
  }
  .pstep .grow {
    flex: 1;
  }
  /* legend and Back/Next stay in view at the bottom of the card when a long step scrolls */
  /* the top of the bar fades in, so text scrolling underneath stays visible and hints there is more */
  .pfoot {
    position: sticky;
    bottom: calc(-1 * var(--s5));
    margin: calc(-1 * var(--s6)) calc(-1 * var(--s5)) calc(-1 * var(--s5));
    padding: var(--s9) var(--s5) var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    background: linear-gradient(to bottom, transparent, var(--bg) calc(var(--s9) - var(--s3)));
    pointer-events: none;
  }
  .pfoot > * {
    pointer-events: auto;
  }
  .ctl {
    padding: var(--s3) var(--s3);
    border-radius: var(--r-l);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: var(--fs-sm);
  }
  .ctl :global(.h) {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ctl :global(.x) {
    border: 0;
    background: none;
    color: var(--muted);
    font-size: var(--fs-lg);
    cursor: pointer;
    padding: 0 var(--s1);
  }
  .ctl :global(.sec) {
    color: var(--muted);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s3);
    font-size: var(--fs-step);
  }
  /* the "i" hint: a small round button whose tip shows on hover or keyboard focus */
  .hint {
    position: relative;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    font: italic var(--fw-bold) 0.8125rem/1 var(--body);
    cursor: help;
  }
  .hint:hover,
  .hint:focus-visible {
    color: var(--fg);
    border-color: var(--faint);
  }
  .hint .tip {
    position: absolute;
    z-index: 20;
    right: 0;
    bottom: calc(100% + var(--s2));
    width: max-content;
    max-width: 16.25rem;
    padding: var(--s2) var(--s3);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    background: var(--surface);
    box-shadow: 0 0.5rem 1.5rem var(--shadow);
    font: var(--fw-regular) var(--fs-sm)/var(--lh-snug) var(--body);
    font-style: normal;
    color: var(--fg);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.25rem);
    transition:
      opacity 0.15s,
      transform 0.15s,
      visibility 0.15s;
  }
  .hint:hover .tip,
  .hint:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .navrow {
    display: flex;
    gap: var(--s2);
  }
  .navrow .btn {
    flex: 1;
    padding: var(--s3) var(--s3);
    font-size: var(--fs-sm);
  }
  .navrow .btn:first-child {
    flex: 0 0 auto;
    padding-inline: var(--s4);
  }
  /* narrow windows: stack, and let the player grow with its text instead of scrolling inside */
  @media (max-width: 990px) {
    .player {
      height: auto;
      min-height: max(30rem, var(--ph));
    }
    .pbody {
      grid-template-columns: minmax(0, 1fr);
      flex: 1;
    }
    .pstage {
      padding-block: var(--s6) var(--s7);
    }
    .pstage > :global(svg) {
      height: auto;
    }
    /* the step grows with its text and scrolls with the page: no inner scroll (it fought page scrolling on touch),
       and Back/Next sit at the end of the card instead of pinned to the screen, so no text can show below them */
    .pstep {
      overflow: visible;
    }
    .pfoot {
      position: static;
      margin: 0;
      padding: 0;
      background: none;
    }
  }
  /* maximized: the player takes the whole window */
  :global(html.focus body) .player {
    position: fixed;
    inset: 0;
    z-index: 50;
    height: auto;
    min-height: 0;
    background: var(--bg);
    padding: calc(env(safe-area-inset-top, 0px) + var(--s4)) var(--s5)
      calc(env(safe-area-inset-bottom, 0px) + var(--s4));
