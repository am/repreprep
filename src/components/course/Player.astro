---
// The step player: the drawing or the panel on the left (on the intro, the lesson's title in big type), the step on the right. The optional challenge is
// one more step after the last one: same player, its own kind. Next on the last step opens the done screen, the same player again,
// closing the lesson; its Next lesson button fills, ticks and plays (src/client/finish.js), then opens the next lesson.
import PlayerHead from "./PlayerHead.astro";
import PlayerFoot from "./PlayerFoot.astro";
import IntroCard from "./IntroCard.astro";
import DoneCard from "./DoneCard.astro";
import StepText from "./StepText.astro";
import Quiz from "./Quiz.astro";
import HearNote from "./HearNote.astro";
import Keys from "./Keys.astro";
import Figure from "./Figure.astro";
import PanelDrawing from "./PanelDrawing.astro";
import UpdateNote from "./UpdateNote.astro";
import { KIND } from "../../course/shared/text.js";
import { stepPath, nextLesson } from "../../course/index.js";
interface Props {
  instrument: any;
  lesson: any;
  /* 0 is the intro; one past the last step is the challenge */
  at: number;
  done?: boolean;
}
const { instrument, lesson, at, done = false } = Astro.props;
const onChallenge = !done && at === lesson.steps.length;
const step = done ? { k: "done" } : onChallenge ? { k: "challenge" } : lesson.steps[at];
const kind = step.k || "play";
// the page light: the last page a step up to this one set
const page = lesson.steps.slice(0, at + 1).reduce((p: number, s: any) => s.page || p, 1);
const next = nextLesson(instrument, lesson);
---

<section
  class="player"
  id="player"
  aria-label="Step player"
  data-inst={instrument.key}
  data-lesson={lesson.id}
  data-step={at}
  data-step-ids={lesson.steps.map((s: any) => s.id).join(" ")}
  data-next={next?.id}
  data-next-path={next?.path}
  data-done={done ? "" : undefined}
  data-challenge={lesson.challenge ? "" : undefined}
  data-done-path={stepPath(lesson, "done")}
>
  <PlayerHead instrument={instrument} lesson={lesson} at={at} done={done} />
  <div class="pbody" id="pbody">
    <div class={step.intro || done ? "pstage intro" : "pstage"}>
      {done ? (
        <DoneCard L={lesson} nx={next} part="hero" />
      ) : step.intro ? (
        <IntroCard L={lesson} part="hero" />
      ) : step.fig ? (
        <div class="figwrap">
          <Figure I={instrument} fig={step.fig} id={`${lesson.id}:${at}`} />
        </div>
      ) : (
        <PanelDrawing I={instrument} hl={step.hl} page={page} />
      )}
    </div>
    <div
      class="gutter"
      id="gutter"
      role="separator"
      aria-orientation="vertical"
      aria-label="Resize the step panel"
      tabindex="0"
      title="Drag to resize · double-click to reset"
    ></div>
    <div class="pstep" id="now">
      <UpdateNote L={lesson} />
      <div class="h">
        <span class={`kind k-${kind}`}>{done ? "Done" : KIND[kind]}</span>
        {onChallenge && " · optional"}
      </div>
      {done ? (
        <DoneCard L={lesson} nx={next} part="details" />
      ) : onChallenge ? (
        <Fragment>
          <div class="ptxt">
            <p>
              <Keys I={instrument} text={lesson.challenge} />
            </p>
          </div>
          <p class="t-note">Optional. Try it now, or come back to it any time.</p>
        </Fragment>
      ) : (
        <Fragment>
          {step.intro ? (
            <IntroCard L={lesson} part="details" />
          ) : (
            <div class="ptxt">
              <StepText I={instrument} st={step} />
            </div>
          )}
          {step.q && <Quiz I={instrument} st={step} />}
          {step.hear && <HearNote I={instrument} st={step} />}
          {step.more && (
            <p class="more">
              <a href={`/${instrument.slug}/${step.more.to}`}>{step.more.text}</a>
            </p>
          )}
        </Fragment>
      )}
      <div class="ctl" id="ctlinfo" hidden></div>
      <div class="grow"></div>
      <PlayerFoot instrument={instrument} lesson={lesson} at={at} done={done} kind={kind} next={next} />
    </div>
  </div>
</section>

<script>
  import "../../client/player.js";
</script>

<style>
  /* step player */
  /* a step's link to a reference tab, under its text */
  .more {
    margin: 0;
    font-size: var(--fs-sm);
  }
  .more a {
    color: inherit;
    text-decoration-color: var(--led);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1875rem;
  }
  .more a:hover {
    color: var(--led);
  }
  /* open on the page, no box: the drawing and the step sit straight on the background */
  .player {
    --ph: calc(100dvh - 2rem);
    height: max(32.5rem, var(--ph));
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    scroll-margin-top: var(--s3);
  }
  .pbody {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0.875rem var(--sw, clamp(18.75rem, 30%, 28.75rem));
    gap: var(--s1);
  }
  .gutter {
    cursor: col-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-s);
    touch-action: none;
  }
  .gutter::before {
    content: "";
    width: 0.25rem;
    height: 2.75rem;
    border-radius: var(--r-xs);
    background: var(--line);
    transition:
      background 0.15s,
      height 0.15s;
  }
  .gutter:hover::before,
  .gutter:focus-visible::before,
  .gutter.drag::before {
    background: var(--led);
    height: 4.5rem;
  }
  .pstage {
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pstage > :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .pstage.intro {
    justify-content: flex-start;
  }
  /* the step keeps its card: it separates the text from the drawing */
  .pstep {
    min-height: 0;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    padding: var(--s5) var(--s5);
    border-radius: var(--r-l);
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .pstep :global(.h) {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-caps);
    color: var(--faint);
    text-transform: uppercase;
  }
  /* on phones the step drops its card outline and padding, so the text runs the full width of the page */
  @media (max-width: 836px) {
    .pstep {
      border: 0;
      border-radius: 0;
      padding-inline: 0;
    }
  }
  .pstep :global(.ptxt) {
    font-size: var(--fs-step);
    line-height: var(--lh-loose);
    margin: 0;
  }
  .ptxt :global(p) {
    margin: 0 0 0.6em;
  }
  .ptxt :global(p:last-child) {
    margin-bottom: 0;
  }
  .pstep .grow {
    flex: 1;
  }
  .ctl {
    padding: var(--s3) var(--s3);
    border-radius: var(--r-l);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: var(--fs-sm);
  }
  .ctl :global(.h) {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ctl :global(.x) {
    border: 0;
    background: none;
    color: var(--muted);
    font-size: var(--fs-lg);
    cursor: pointer;
    padding: 0 var(--s1);
  }
  .ctl :global(.sec) {
    color: var(--muted);
  }
  /* narrow windows: stack, and let the player grow with its text instead of scrolling inside */
  @media (max-width: 990px) {
    .player {
      height: auto;
      min-height: max(30rem, var(--ph));
    }
    .pbody {
      grid-template-columns: minmax(0, 1fr);
      flex: 1;
    }
    .pstage {
      padding-block: var(--s6) var(--s7);
    }
    .pstage > :global(svg) {
      height: auto;
    }
    /* the step grows with its text and scrolls with the page: no inner scroll (it fought page scrolling on touch),
       and Back/Next sit at the end of the card instead of pinned to the screen, so no text can show below them */
    .pstep {
      overflow: visible;
    }
  }
  /* maximized: the player takes the whole window */
  :global(html.focus body) .player {
    position: fixed;
    inset: 0;
    z-index: 50;
    height: auto;
    min-height: 0;
    background: var(--bg);
    padding: calc(env(safe-area-inset-top, 0px) + var(--s4)) var(--s5)
      calc(env(safe-area-inset-bottom, 0px) + var(--s4));
    overflow: auto;
  }
  :global(html.focus body) .pbody {
    grid-template-columns: minmax(0, 1fr) 0.875rem var(--sw, clamp(20rem, 30%, 32.5rem));
  }
  @media (max-width: 990px) {
    :global(html.focus body) .pbody {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 990px) {
    .gutter {
      display: none;
    }
  }
  .pstep .h .kind {
    display: inline-block;
    padding: 1px var(--s2);
    border-radius: var(--r-pill);
    margin-right: var(--s2);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caps);
  }
  .kind.k-intro {
    background: var(--surface);
    color: var(--fg);
  }
  .kind.k-learn {
    background: var(--turn-soft);
    color: var(--turn);
  }
  .kind.k-play {
    background: var(--led-soft);
    color: var(--led);
  }
  .kind.k-check {
    background: var(--done-soft);
    color: var(--done);
  }
  .kind.k-challenge {
    background: var(--hold-soft);
    color: var(--hold);
  }
  .kind.k-done {
    background: var(--done-soft);
    color: var(--done);
  }
</style>
