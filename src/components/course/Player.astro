---
// The step player: the drawing or the panel on the left, the step on the right. The optional challenge is
// one more step after the last one: same player, its own kind, and Finish moves there.
import LessonMenu from "./LessonMenu.astro";
import IntroCard from "./IntroCard.astro";
import StepText from "./StepText.astro";
import Quiz from "./Quiz.astro";
import HearNote from "./HearNote.astro";
import Keys from "./Keys.astro";
import Figure from "./Figure.astro";
import PanelDrawing from "./PanelDrawing.astro";
import { KIND, keyCap } from "../../course/shared/text.js";
import { lessonLabel, stepPath, nextLesson } from "../../course/index.js";
interface Props { I: any; L: any; act: number }
const { I, L, act } = Astro.props;
const n = L.steps.length, total = n + (L.challenge ? 1 : 0);
const ch = act === n;
const st = ch ? { k: "challenge" } : L.steps[act];
const k = st.k || "play";
const end = act === total - 1;
const nx = nextLesson(I, L);
const nextHref = end ? (nx ? nx.path : L.path) : stepPath(L, act + 1);
const legend = keyCap("PRESS", "press") + keyCap("HOLD", "hold") + keyCap("TURN", "turn");
---
<section class="player" id="player" aria-label="Step player" data-inst={I.key} data-lesson={L.id} data-step={act} data-steps={n} data-next={nx?.id} data-next-path={nx?.path}>
  <div class="phead"><details class="picker"><summary class="ttl" title="Jump to another lesson">{lessonLabel(L)} · {L.title}<span class="caret" aria-hidden="true"></span></summary><LessonMenu I={I} L={L} /></details><div class="dots" style={`--p:${total > 1 ? act / (total - 1) : 0}`}>{L.steps.map((s: any, i: number) => { const lab = KIND[s.k || "play"]; return <a href={stepPath(L, i)} data-step={i} aria-current={String(i === act)} aria-label={`${lab}, step ${i + 1}`} title={lab}></a>; })}{L.challenge && <a class="opt" href={stepPath(L, n)} data-step={n} aria-current={String(ch)} aria-label="Challenge (optional)" title="Challenge (optional)"></a>}</div><button class="maxbtn" type="button" data-max aria-label="Maximize" title="Maximize"><svg class="mx-in" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/></svg><svg class="mx-out" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2v4H2M14 6h-4V2M10 14v-4h4M2 10h4v4"/></svg></button></div>
  <div class="pbody" id="pbody"><div class="pstage">{st.fig ? <div class="figwrap"><Figure I={I} fig={st.fig} id={`${L.id}:${act}`} /></div> : <PanelDrawing I={I} hl={st.hl} />}</div><div class="gutter" id="gutter" role="separator" aria-orientation="vertical" aria-label="Resize the step panel" tabindex="0" title="Drag to resize · double-click to reset"></div>
    <div class="pstep" id="now"><div class="h"><span class={`kind k-${k}`}>{KIND[k]}</span>{ch && " · optional"}</div>
      {ch ? (
        <Fragment><div class="ptxt"><p><Keys I={I} text={L.challenge} /></p></div><p class="t-note">Optional. Try it now, or come back to it any time.</p></Fragment>
      ) : (
        <Fragment>{st.intro ? <IntroCard L={L} /> : <div class="ptxt"><StepText I={I} st={st} /></div>}{st.q && <Quiz I={I} st={st} />}{st.hear && <HearNote I={I} st={st} />}</Fragment>
      )}
      <div class="ctl" id="ctlinfo" hidden></div>
      <div class="grow"></div>
      <div class="pfoot">
        <div class="legend" hidden={k !== "play"}><Fragment set:html={legend} /><button type="button" class="hint" aria-label="Tips: click a control to learn it. Left and right arrow keys move between steps.">i<span class="tip" aria-hidden="true">Click a control to learn it. The ← → keys move between steps.</span></button></div>
        <div class="navrow">{act === 0
          ? <button class="btn" disabled aria-label="Previous step">Back</button>
          : <a class="btn" href={stepPath(L, act - 1)} data-nav="-1" aria-label="Previous step">Back</a>}<a class="btn primary" href={nextHref} data-nav="1" data-end={end ? "" : undefined}>{end ? "Finish" : act === 0 ? "Start" : "Next"}</a></div>
      </div>
    </div></div>
</section>

<script>
  /* Marks where you are, saves ticks as you move on, and runs the player's controls: the step panel's
     width, the full-window switch, the lesson picker, arrow keys, and clicking a control on the panel. */
  import { onProgress, persist, refresh, ist, state } from "../../client/progress.js";
  import { player, curLesson, markAllDone, goNextLesson } from "../../client/lesson.js";
  import { CYCLES_CONTROLS, iconSvg } from "../../course/model-cycles/controls.js";
  import { keyify } from "../../course/shared/text.js";
  import { esc } from "../../course/shared/html.js";

  const PANELS = { cycles: { controls: CYCLES_CONTROLS, icon: iconSvg } };
  const $ = (s) => document.querySelector(s);

  /* the player fills the window below the header */
  function fitPlayer() {
    const el = player(); if (!el) return;
    const top = el.getBoundingClientRect().top + window.scrollY;
    el.style.setProperty("--ph", `calc(100dvh - ${Math.round(top) + 20}px)`);
  }
  window.addEventListener("resize", fitPlayer);

  onProgress(() => {
    const c = curLesson(); if (!c) return;
    const s = ist(c.k);
    if (s.lesson !== c.id || (s.active[c.id] ?? 0) !== c.act) { s.lesson = c.id; s.active[c.id] = c.act; persist(); }
    document.querySelectorAll(".dots [data-step]").forEach((a) => a.classList.toggle("done", !!s.steps[c.id + ":" + a.dataset.step]));
    const mx = $("[data-max]"); if (mx) { const l = state.focus ? "Exit full window (Esc)" : "Maximize"; mx.setAttribute("aria-label", l); mx.title = l; }
    document.documentElement.classList.toggle("focus", !!state.focus);
    if (state.stepW) document.documentElement.style.setProperty("--sw", state.stepW + "px");
    fitPlayer();
  });
  function setFocus(on) { state.focus = on; persist(); refresh(); }

  /* drag the gutter to resize the step column; the width is saved with your progress */
  function clampStepW(w) { const b = $("#pbody"); const max = b ? Math.max(320, b.clientWidth * 0.7) : 900; return Math.round(Math.min(Math.max(w, 260), max)); }
  function setStepW(w, save) { state.stepW = clampStepW(w); document.documentElement.style.setProperty("--sw", state.stepW + "px"); if (save) persist(); }
  document.addEventListener("pointerdown", (e) => {
    const g = e.target.closest("#gutter"); if (!g) return;
    e.preventDefault(); g.setPointerCapture(e.pointerId); g.classList.add("drag"); document.body.classList.add("resizing");
    const right = $("#pbody").getBoundingClientRect().right;
    const move = (ev) => setStepW(right - ev.clientX, false);
    const up = () => { g.removeEventListener("pointermove", move); g.classList.remove("drag"); document.body.classList.remove("resizing"); persist(); };
    g.addEventListener("pointermove", move); g.addEventListener("pointerup", up, { once: true }); g.addEventListener("pointercancel", up, { once: true });
  });
  document.addEventListener("dblclick", (e) => { if (e.target.closest("#gutter")) { delete state.stepW; document.documentElement.style.removeProperty("--sw"); persist(); } });

  /* lesson picker: close when clicking elsewhere or pressing Esc */
  document.addEventListener("click", (e) => { document.querySelectorAll("details.picker[open]").forEach((d) => { if (!d.contains(e.target)) d.open = false; }); }, true);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") { const d = $("details.picker[open]"); if (d) { d.open = false; e.stopImmediatePropagation(); } } }, true);

  document.addEventListener("click", (e) => {
    if (e.target.closest("[data-closectl]")) { $("#ctlinfo").hidden = true; return; }
    if (e.target.closest("[data-max]")) { setFocus(!state.focus); return; }
    /* a control on the panel: what it does, in a box over the step */
    const ctl = e.target.closest("svg .c");
    if (ctl) {
      if (ctl.closest("[data-panel-guide]")) return;
      const I = PANELS[document.body.dataset.inst], c = I && I.controls[ctl.dataset.id], box = $("#ctlinfo");
      if (c && box) { box.hidden = false; box.innerHTML = `<div class="h">${esc(c.kind)} <button class="x" data-closectl aria-label="Close">×</button></div><b>${esc(c.name)}</b>${c.sub ? ` <span class="sec">(${esc(c.sub)})</span>` : ""}. ${keyify(I, c.desc, "")}`; }
      return;
    }
    /* Next ticks the step you're on; Finish on the last step moves to the next lesson */
    const nav = e.target.closest("[data-nav]");
    const c = nav && nav.dataset.nav === "1" && curLesson(); if (!c) return;
    const s = ist(c.k);
    if (c.act < c.n) { s.steps[c.id + ":" + c.act] = true; markAllDone(s, c); } /* the optional challenge is never a rep */
    if (nav.hasAttribute("data-end")) { e.preventDefault(); goNextLesson(s, c); return; }
    persist(); /* the link opens the next step */
  }, true); /* capture: runs before the router follows a link, so Finish can pick where to go */

  document.addEventListener("keydown", (e) => {
    if (e.target.id === "gutter" && (e.key === "ArrowLeft" || e.key === "ArrowRight")) { e.preventDefault(); const cur = $(".pstep").getBoundingClientRect().width; setStepW(cur + (e.key === "ArrowLeft" ? 40 : -40), true); return; }
    if (player() && !e.target.closest("textarea,input,select") && !e.metaKey && !e.ctrlKey && !e.altKey) {
      if (e.key === "Escape" && state.focus) { setFocus(false); return; }
      const nav = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (nav) { const b = $(`[data-nav="${nav}"]`); if (b) { e.preventDefault(); b.click(); } }
    }
  });
</script>
