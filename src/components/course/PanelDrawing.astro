---
// The instrument's panel, with the controls a step uses lit (hl) or one control selected (sel), and the page light the step is on.
import { withHl, withPage } from "../../course/shared/text.js";
interface Props {
  I: any;
  hl?: string;
  sel?: string;
  page?: number;
}
const { I, hl = "", sel, page = 1 } = Astro.props;
---

<Fragment set:html={withHl(withPage(I.draw(), page), hl, sel)} />

<script>
  /* the panel's controls are buttons for the keyboard too: Enter or Space clicks them */
  document.addEventListener("keydown", (e) => {
    if ((e.key === "Enter" || e.key === " ") && e.target.classList && e.target.classList.contains("c")) {
      e.preventDefault();
      e.target.dispatchEvent(new MouseEvent("click", { bubbles: true }));
    }
  });
</script>
