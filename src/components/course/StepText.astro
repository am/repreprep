---
// A step's text: an optional short title, a key combo as numbered rows if it has one, then a lead and body (Learn, Check)
// or one bullet per action (Play). With comboAfter, the combo comes after that many bullets instead.
import Keys from "./Keys.astro";
import { stepParts } from "../../course/shared/text.js";
import { renderCombo } from "../../course/shared/combo.js";
interface Props {
  I: any;
  st: any;
}
const { I, st } = Astro.props;
const { lead, first, rest, para, items } = stepParts(st);
const combo = st.combo ? renderCombo(I, st.combo) : "";
const at = st.comboAfter || 0;
const bullets = items || (at && para !== undefined ? [para] : null);
---

{lead && (
  <h3 class="t-title t-step">
    <Keys I={I} text={lead} hl={st.hl} />
  </h3>
)}
{combo && !at && <Fragment set:html={combo} />}
{first !== undefined ? (
  <Fragment>
    <p class="t-lead">
      <Keys I={I} text={first} hl={st.hl} />
    </p>
    {rest && (
      <p class="t-body">
        <Keys I={I} text={rest} hl={st.hl} />
      </p>
    )}
  </Fragment>
) : !bullets ? (
  <p>
    <Keys I={I} text={para} hl={st.hl} />
  </p>
) : (
  <Fragment>
    <ul class="pacts">
      {bullets.slice(0, at || bullets.length).map((x: string) => (
        <li>
          <Keys I={I} text={x} hl={st.hl} />
        </li>
      ))}
    </ul>
    {combo && at > 0 && <Fragment set:html={combo} />}
    {at > 0 && at < bullets.length && (
      <ul class="pacts">
        {bullets.slice(at).map((x: string) => (
          <li>
            <Keys I={I} text={x} hl={st.hl} />
          </li>
        ))}
      </ul>
    )}
  </Fragment>
)}

<style>
  .pacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9em;
  }
  .pacts li {
    position: relative;
    padding-left: 1.15em;
  }
  .pacts li::before {
    content: "";
    position: absolute;
    left: 0.1em;
    top: calc(0.5lh - 0.16em);
    width: 0.42em;
    height: 0.42em;
    border-radius: 50%;
    background: var(--led);
  }
</style>
