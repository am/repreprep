---
// Under the player: your notes (read, then Edit to write), finishing the lesson and clearing its progress. The steps and the
// challenge live in the player, so they aren't repeated here.
import { lessonLabel } from "../../course/index.js";
interface Props {
  I: any;
  L: any;
}
const { I, L } = Astro.props;
---

<section class="wrapup stack" aria-label="After the lesson">
  <section class="notebox" data-notebox={L.id} aria-labelledby={`nb-${L.id}`}>
    <div class="nb-h">
      <h2 class="t-title t-card" id={`nb-${L.id}`}>
        Notes
      </h2>
      <button type="button" class="btn" data-note-edit>
        Add a note
      </button>
    </div>
    <div class="nb-view">
      <p class="t-body nb-text" hidden></p>
      <p class="t-note nb-empty">Nothing yet. Presets you liked, what was hard, ideas for next time.</p>
    </div>
    <div class="nb-edit" hidden>
      <textarea
        aria-label={`Notes for ${lessonLabel(L).toLowerCase()}`}
        placeholder="Presets you liked, what was hard, ideas for next time"
      ></textarea>
      <div class="row">
        <button type="button" class="btn primary" data-note-save>
          Save
        </button>
        <button type="button" class="btn" data-note-cancel>
          Cancel
        </button>
      </div>
    </div>
    <p class="t-note nb-stamp" hidden>
      Saved in this browser.
    </p>
  </section>
  <div class="finish">
    <button
      class="btn primary"
      data-finish={L.id}
      data-label="Complete"
      title={`Mark this ${L.song ? "study" : "lesson"} done`}
    >
      Complete
    </button>
    <a class="btn" href={`/${I.slug}`}>
      All lessons
    </a>
    <button
      class="btn danger"
      data-clear={L.id}
      data-path={L.path}
      title={`Untick every step of this ${L.song ? "study" : "lesson"} and start it again from the intro`}
      hidden
    >
      Clear progress
    </button>
    <span class="stamp" hidden></span>
  </div>
</section>

<script>
  import "../../client/wrapup.js";
</script>

<style>
  .notebox {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }
  .nb-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
  }
  .nb-text {
    max-width: 72ch;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .nb-edit {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }
  .nb-edit textarea {
    width: 100%;
    min-height: 7.5rem;
    padding: var(--s3);
    border-radius: var(--r-m);
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--fg);
    font: inherit;
    font-size: var(--fs-sm);
    resize: vertical;
  }
  .nb-edit textarea:focus {
    outline: 2px solid var(--led);
    outline-offset: 1px;
  }
  .nb-stamp {
    color: var(--done);
  }
  .finish {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    align-items: center;
  }
  .finish .stamp {
    font-family: var(--mono);
    font-size: var(--fs-s);
    color: var(--done);
  }
</style>
