---
// A link to a lesson with its short name and a progress dot, and an "Updated" tag when the lesson changed
// since you started it (client/updates.js). The browser script fills in the dot and points the link at the
// step you were on.
interface Props {
  l: any;
  class: string;
  current?: boolean;
}
const { l, class: cls, current = false } = Astro.props;
---

<a class={cls} href={l.path} data-lesson={l.id} data-path={l.path} aria-current={String(current)}>
  <span class="n">{l.short}</span>
  <slot />
  <span class="end">
    <span class="u" data-upd-tag={l.id} hidden>
      Updated
    </span>
    <span class="s" data-prog={l.id}></span>
  </span>
</a>

<script>
  /* each lesson's progress dot, and its link pointing at the step you were on */
  import { onProgress, here, sizes, lessonPct, stepHref } from "../../client/progress.js";
  onProgress(() => {
    const s = here();
    if (!s) return;
    const sz = sizes();
    document.querySelectorAll("[data-prog]").forEach((el) => {
      const id = el.dataset.prog;
      const p = lessonPct(s, id, sz[id] || 0);
      el.className = "s " + (s.done[id] || p === 1 ? "full" : p > 0 ? "part" : "");
      el.style.setProperty("--p", Math.round(p * 100) + "%");
    });
    document.querySelectorAll("a[data-lesson][data-path]").forEach((a) => {
      a.href = stepHref(a.dataset.path, s.active[a.dataset.lesson] || 0);
    });
  });
</script>

<style>
  .end {
    display: flex;
    align-items: center;
    gap: var(--s2);
  }
  .u {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-key);
    text-transform: uppercase;
    color: var(--led);
  }
  .u[hidden] {
    display: none;
  }
  a.wk,
  a.pm-i {
    color: inherit;
    text-decoration: none;
  }
  .wk {
    display: grid;
    grid-template-columns: 2.125rem 1fr auto;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--s2);
    border-radius: var(--r-m);
    border: 1px solid transparent;
    background: none;
    text-align: left;
    cursor: pointer;
    width: 100%;
  }
  .wk:hover {
    background: var(--surface);
  }
  .wk .n {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .wk :global(.t) {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .wk .s {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--faint);
  }
  .wk .s.part {
    border-color: var(--hold);
    background: conic-gradient(var(--hold) var(--p, 0%), transparent 0);
  }
  .wk .s.full {
    border-color: var(--done);
    background: var(--done);
  }
  .pm-i {
    display: grid;
    grid-template-columns: 1.875rem 1fr auto;
    align-items: center;
    gap: var(--s2);
    width: 100%;
    padding: var(--s2) var(--s2);
    border: 0;
    border-radius: var(--r-s);
    background: none;
    text-align: left;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
  .pm-i:hover {
    background: var(--surface-2);
  }
  .pm-i[aria-current="true"] {
    background: var(--led-soft);
  }
  .pm-i .n {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .pm-i :global(.t) {
    line-height: var(--lh-snug);
  }
  .pm-i .s {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    border: 1.5px solid var(--faint);
  }
  .pm-i .s.part {
    border-color: var(--hold);
    background: conic-gradient(var(--hold) var(--p, 0%), transparent 0);
  }
  .pm-i .s.full {
    border-color: var(--done);
    background: var(--done);
  }
</style>
