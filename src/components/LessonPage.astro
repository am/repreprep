---
import Base from "../layouts/Base.astro";
import { wkLabel } from "../course/index.js";
import { player, lessonText } from "../course/views.js";
const { I, L, act } = Astro.props;
const title = `${wkLabel(L)}: ${L.title}` + (act === L.steps.length ? " (challenge)" : act ? ` (${act + 1}/${L.steps.length})` : "");
---
<Base title={title} description={L.goal} inst={I} tab="lessons">
  <Fragment set:html={player(I, L, act)} />
  <div class="below"><Fragment set:html={lessonText(I, L)} /></div>
</Base>
