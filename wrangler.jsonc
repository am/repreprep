{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repreprep",
  // The "repreprep" Cloudflare account, which holds the Worker, the database and repreprep.studio.
  "account_id": "1cb2cb969864b028deeaa699ccbcef21",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Progress and accounts (production only; previews use their own database, below).
  // The tables are created by the app itself the first time it runs.
  "d1_databases": [
    { "binding": "DB", "database_name": "repreprep", "database_id": "58f6e6ef-5d5e-464e-9ef7-11d82ac5cbe5" },
  ],
  // Contact-form messages are emailed through Cloudflare Email Routing (enabled on repreprep.studio).
  // The recipient is the CONTACT_TO secret and must be a verified destination address.
  // Sign-in emails (magic links) go to any address through Cloudflare Email Service, from one sender only.
  "send_email": [{ "name": "MAIL" }, { "name": "EMAIL", "allowed_sender_addresses": ["signin@repreprep.studio"] }],
  // The site's address. Deploys attach both and Cloudflare creates their DNS records and certificates.
  // www → repreprep.studio is a Redirect Rule in the zone (static pages are served before the Worker runs).
  // With routes set, workers.dev and preview URLs would default to off; PR previews need them.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "repreprep.studio", "custom_domain": true },
    { "pattern": "www.repreprep.studio", "custom_domain": true },
  ],
  "observability": { "enabled": true },
  // PR previews: a separate Worker (repreprep-preview) with its own database and no production secrets,
  // so code under review never touches real accounts. Built with CLOUDFLARE_ENV=preview (see deploy.yml).
  // Bindings and routes are not inherited, so each one is listed again here.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "repreprep-preview",
          "database_id": "cbce29da-5ccb-4bc5-95b4-9b89a0a27b30",
        },
      ],
      "routes": [],
      "workers_dev": true,
      "preview_urls": true,
    },
  },
}
